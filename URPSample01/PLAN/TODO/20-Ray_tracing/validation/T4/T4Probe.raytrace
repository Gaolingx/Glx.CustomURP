#pragma max_recursion_depth 2
#include "Packages/com.unity.render-pipelines.universal/Shaders/RayTracing/GlxHitLightCounters.hlsl"

// Driver only: the production GlxDXR material pass selects lights and traces shadows.
// Use the same packed payload decode / counter atomics as production, not a test-side selector.
struct Request { float4 originTMin; float4 directionTMax; };
StructuredBuffer<Request> _GlxRays;
RWStructuredBuffer<GlxBasicPayload> _GlxResults;

[shader("raygeneration")]
void T4Trace()
{
    uint i = DispatchRaysIndex().x;
    Request input = _GlxRays[i];
    RayDesc ray;
    ray.Origin = input.originTMin.xyz;
    ray.Direction = normalize(input.directionTMax.xyz);
    ray.TMin = input.originTMin.w;
    ray.TMax = input.directionTMax.w;
    GlxBasicPayload p = GlxEmptyPayload(GlxProbeMode);
    TraceRay(_GlxScene, RAY_FLAG_NONE, 0xff, 0, 1, 0, ray, p);
    GlxRecordLightCounters(p);
    _GlxResults[i] = p;
}

[shader("miss")]
void T4Miss(inout GlxBasicPayload p : SV_RayPayload)
{
    p = GlxEmptyPayload(p.mode);
    p.flags = GlxMiss;
}
