#pragma max_recursion_depth 2

#include "Packages/com.unity.render-pipelines.universal/Shaders/RayTracing/GlxBasicPayload.hlsl"
#include "Packages/com.unity.render-pipelines.universal/Shaders/RayTracing/GlxHitLightCounters.hlsl"

// Fixture driver: the production Lit GlxDXR pass evaluates the hit's low-frequency term from
// the globally bound ambient/probe snapshot. Requests carry GlxReflectionMode.
struct R3Ray
{
    float4 originTMin;
    float4 directionTMax;
    uint4 meta;
};

StructuredBuffer<R3Ray> _R3Rays;
RWStructuredBuffer<GlxBasicPayload> _R3Results;
uint _R3Count;

[shader("raygeneration")]
void R3Trace()
{
    uint index = DispatchRaysIndex().x;
    if (index >= _R3Count) { _R3Results[index] = GlxEmptyPayload(0); return; }
    R3Ray request = _R3Rays[index];
    GlxBasicPayload payload = GlxEmptyPayload(request.meta.x);
    RayDesc ray;
    ray.Origin = request.originTMin.xyz;
    ray.Direction = request.directionTMax.xyz;
    ray.TMin = request.originTMin.w;
    ray.TMax = request.directionTMax.w;
    TraceRay(_GlxScene, RAY_FLAG_NONE, 0xff, 0, 1, 0, ray, payload);
    if (GlxUsesLightTable(request.meta.x)) GlxRecordLightCounters(payload);
    _R3Results[index] = payload;
}

[shader("miss")]
void R3Miss(inout GlxBasicPayload payload : SV_RayPayload)
{
    uint mode = payload.mode;
    payload = GlxEmptyPayload(mode);
    payload.flags = GlxMiss;
}
