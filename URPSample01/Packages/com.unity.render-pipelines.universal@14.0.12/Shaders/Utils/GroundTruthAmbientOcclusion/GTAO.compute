// Ground Truth Ambient Occlusion horizon search, ported from HDRP 14.0.12 GTAO.compute.
#pragma kernel GTAOMain

#pragma multi_compile HALF_RES FULL_RES
#pragma multi_compile _ TEMPORAL
#pragma multi_compile _ GTAO_NORMALS_OCT
#pragma multi_compile _ GTAO_ORTHO
#pragma multi_compile _ GTAO_XR_ARRAY

#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/GroundTruthAmbientOcclusion/GTAOCommon.hlsl"

// Full resolution world space normal (or oct-encoded GBuffer normal) with encoded smoothness in alpha.
GTAO_TEXTURE2D_FLOAT4(_GtaoNormalTexture);
GTAO_RW_TEXTURE2D_FLOAT(_GtaoPackedData);

// --------------------------------------------
// Options
// --------------------------------------------

// Integral type
#define INTEGRAL_UNIFORM 0
#define INTEGRAL_COSINE 1
#define INTEGRAL_TYPE INTEGRAL_COSINE

// Noise options
#define TEMPORAL_ROTATION defined(TEMPORAL)
#define ENABLE_TEMPORAL_OFFSET defined(TEMPORAL)

// --------------------------------------------
// Integration functions
// --------------------------------------------

float IntegrateArcUniform(float horizon1, float horizon2)
{
    return (1.0f - cos(horizon1) + (1.0 - cos(horizon2)));
}

float IntegrateArcCosWeighted(float horizon1, float horizon2, float n, float cosN)
{
    float h1 = horizon1 * 2.0;
    float h2 = horizon2 * 2.0;
    float sinN = sin(n);
    return 0.25 * ((-cos(h1 - n) + cosN + h1 * sinN) + (-cos(h2 - n) + cosN + h2 * sinN));
}

float UpdateHorizon(float maxH, float candidateH, float distSq)
{
    float falloff = saturate((1.0 - (distSq * _GtaoInvRadiusSq)));
    return (candidateH > maxH) ? lerp(maxH, candidateH, falloff) : lerp(maxH, candidateH, 0.03f);
}

// --------------------------------------------
// Direction functions
// --------------------------------------------

float2 GetDirection(uint2 positionSS, int offset)
{
    float noise = InterleavedGradientNoise(positionSS, 0);
    float rotations[] = { 60.0, 300.0, 180.0, 240.0, 120.0, 0.0 };

#if TEMPORAL_ROTATION
    float rotation = (rotations[(int)_GtaoTemporalRotationIdx] / 360.0);
#else
    float rotation = (rotations[offset] / 360.0);
#endif

    noise += rotation;
    noise *= PI;

    return float2(cos(noise), sin(noise));
}

// --------------------------------------------
// Get sample start offset
// --------------------------------------------

float GetOffset(uint2 positionSS)
{
    float offset = 0.25 * ((positionSS.y - positionSS.x) & 0x3);

#if ENABLE_TEMPORAL_OFFSET
    float offsets[] = { 0.0, 0.5, 0.25, 0.75 };
    offset += offsets[(int)_GtaoTemporalOffsetIdx];
#endif
    return frac(offset);
}

// --------------------------------------------
// Kernel
// --------------------------------------------

float HorizonLoop(float3 positionVS, float3 V, float2 rayStart, float2 rayDir, float rayOffset, float rayStep)
{
    float maxHorizon = -1.0f;  // cos(pi)
    float t = rayOffset * rayStep + rayStep;

    const uint startWithLowerRes = min(max(0, _GtaoStepCount / 2 - 2), 3);
    for (uint i = 0; i < _GtaoStepCount; i++)
    {
        float2 samplePos = max(2, min(rayStart + t * rayDir, _GtaoBufferSize.xy - 2));

        float sampleDepth = GTAOGetDepthSample(samplePos, i > startWithLowerRes);
        float3 samplePosVS = GTAOGetPositionVS(samplePos.xy, sampleDepth);

        float3 deltaPos = samplePosVS - positionVS;
        float deltaLenSq = dot(deltaPos, deltaPos);

        float currHorizon = dot(deltaPos, V) * rsqrt(deltaLenSq);
        maxHorizon = UpdateHorizon(maxHorizon, currHorizon, deltaLenSq);

        t += rayStep;
    }

    return maxHorizon;
}

[numthreads(8, 8, 1)]
void GTAOMain(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    GTAO_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    // Read buffers as early as possible.
    float currDepth = GTAOGetDepthForCentral(dispatchThreadId.xy);
    float3 positionVS = GTAOGetPositionVS(dispatchThreadId.xy, currDepth);

#ifdef HALF_RES
    int2 normalPixel = min((int2)dispatchThreadId.xy * 2, (int2)_GtaoScreenSize.xy - 1);
#else
    int2 normalPixel = (int2)dispatchThreadId.xy;
#endif
    float4 normalBufferData = GTAO_LOAD(_GtaoNormalTexture, normalPixel);

    float offset = GetOffset(dispatchThreadId.xy);
    float2 rayStart = dispatchThreadId.xy;
    float integral = 0;

#ifdef TEMPORAL
    const int dirCount = 1;
#else
    const int dirCount = (int)_GtaoDirectionCount;
#endif

    float3 V = normalize(-positionVS);
#ifdef GTAO_ORTHO
    // Orthographic projection has no perspective divide: a world-space radius always covers the same
    // number of AO pixels regardless of depth.
    float fovCorrectedradiusSS = clamp(
        _GtaoRadiusInWorld * _GtaoBufferSize.y / (2.0 * _GtaoOrthoHalfSize.y),
        (float)_GtaoStepCount,
        (float)_GtaoMaxRadiusInPixels);
#else
    float fovCorrectedradiusSS = clamp(_GtaoRadiusInWorld * _GtaoFOVCorrection * rcp(positionVS.z), (float)_GtaoStepCount, (float)_GtaoMaxRadiusInPixels);
#endif
    float step = max(1, fovCorrectedradiusSS * _GtaoInvStepCountPlusOne);

    // Unrolled for Metal, which crashes on the non-uniform loop in some versions.
#if defined(TEMPORAL) || defined(SHADER_API_METAL)
    [unroll]
#endif
    for (int i = 0; i < dirCount; ++i)
    {
        float2 dir = GetDirection(dispatchThreadId.xy, i);

        // Tiny epsilon works around a driver bug that otherwise produces incorrect output.
        float2 negDir = -dir + 1e-30;

        float2 maxHorizons;
        maxHorizons.x = HorizonLoop(positionVS, V, rayStart, dir, offset, step);
        maxHorizons.y = HorizonLoop(positionVS, V, rayStart, negDir, offset, step);

        float3 normalVS = GTAOGetNormalVS(normalBufferData);

        float3 sliceN = normalize(cross(float3(dir.xy, 0.0f), V.xyz));
        float3 projN = normalVS - sliceN * dot(normalVS, sliceN);
        float projNLen = length(projN);
        float cosN = dot(projN / projNLen, V);

        float3 T = cross(V, sliceN);
        float N = -sign(dot(projN, T)) * GTAOFastAcos(cosN);

        maxHorizons.x = -GTAOFastAcos(maxHorizons.x);
        maxHorizons.y = GTAOFastAcos(maxHorizons.y);
        maxHorizons.x = N + max(maxHorizons.x - N, -HALF_PI);
        maxHorizons.y = N + min(maxHorizons.y - N, HALF_PI);
        integral += AnyIsNaN(maxHorizons) ? 1 : IntegrateArcCosWeighted(maxHorizons.x, maxHorizons.y, N, cosN);
    }

    integral /= dirCount;

    if (currDepth == UNITY_RAW_FAR_CLIP_VALUE || integral < -1e-2f)
        integral = 1;

    GTAO_STORE(_GtaoPackedData, dispatchThreadId.xy, GTAOPackAOOutput(saturate(integral), currDepth));
}