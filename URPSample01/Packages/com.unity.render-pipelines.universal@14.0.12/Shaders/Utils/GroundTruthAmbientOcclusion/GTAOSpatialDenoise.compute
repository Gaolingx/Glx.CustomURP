// GTAO spatial bilateral denoise, ported from HDRP 14.0.12 GTAOSpatialDenoise.compute.
#pragma kernel SpatialDenoise

#pragma multi_compile _ TO_TEMPORAL
#pragma multi_compile _ GTAO_XR_ARRAY

#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/GroundTruthAmbientOcclusion/GTAOCommon.hlsl"

GTAO_TEXTURE2D_FLOAT(_GtaoPackedData);
GTAO_RW_TEXTURE2D_FLOAT(_GtaoOcclusionTexture);

#define BILATERAL_EPSILON 0.01

float BilateralWeight(float sampleDepth, float linearCentralDepth)
{
    float linearSample = LinearEyeDepth(sampleDepth, _GtaoZBufferParams);
    float delta = abs(linearSample - linearCentralDepth);
    float w = saturate(1.0f - (_GtaoSpatialBilateralAggressiveness * delta + BILATERAL_EPSILON));

    return w;
}

// Bilateral spatial denoise over the 3x3 neighbourhood. The neighbour fetches use explicit integer
// loads: the HDRP original derives them from a bilinearly clamped UV and GatherRed, and in the URP
// compatibility compute path that combination returns a degenerate screen-column pattern.
float Blur(uint2 centralPos, out float centralDepth, out float centralAO)
{
    int2 limit = max((int2)_GtaoBufferSize.xy - 1, int2(0, 0));
    int2 central = clamp((int2)centralPos, int2(0, 0), limit);

    float packedCentral = GTAO_LOAD(_GtaoPackedData, central);
    GTAOUnpackData(packedCentral, centralAO, centralDepth);
    float linearCentralDepth = LinearEyeDepth(centralDepth, _GtaoZBufferParams);

    float total = centralAO;
    float totalWeight = 1.0;

    [unroll]
    for (int dy = -1; dy <= 1; dy++)
    {
        [unroll]
        for (int dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dy == 0)
                continue;

            float ao, depth;
            GTAOUnpackData(GTAO_LOAD(_GtaoPackedData, clamp(central + int2(dx, dy), int2(0, 0), limit)), ao, depth);
            float weight = BilateralWeight(depth, linearCentralDepth);
            total += weight * ao;
            totalWeight += weight;
        }
    }

    return total / totalWeight;
}

[numthreads(8, 8, 1)]
void SpatialDenoise(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    GTAO_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    if (dispatchThreadId.x >= (uint)_GtaoBufferSize.x || dispatchThreadId.y >= (uint)_GtaoBufferSize.y)
        return;

    float centralDepth, centralAO;
    float final = Blur(dispatchThreadId.xy, centralDepth, centralAO);

#if TO_TEMPORAL
    GTAO_STORE(_GtaoOcclusionTexture, dispatchThreadId.xy, GTAOPackAOOutput(final, centralDepth));
#else
    GTAO_STORE(_GtaoOcclusionTexture, dispatchThreadId.xy, GTAOOutputFinalAO(final));
#endif
}
