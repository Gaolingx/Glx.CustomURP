// P3 (B3): shade screen-space reflection hits from the current-frame GBuffer.
//
// The opaque SSR pass runs after the GBuffer pass (event 220), so an SS hit can be re-shaded from
// the hit pixel's surface (GBuffer0/1/2 + depth) with the same SsrShadeSurface the RT hit kernel
// uses. The shaded radiance is published into the slot-indexed _R2Hits with the SS source bit; the
// reproject kernel then reads it instead of the previous-frame colour pyramid, and R2Temporal only
// folds RT hits into the hardware history (so SS is not counted twice).
//
// The geometric coverage is unchanged: the R1 classification already stored the prev-colour opacity
// (screen-edge x roughness fade) in ssShare; P3 keeps that coverage and only replaces the radiance.
#pragma kernel SsrHitSs

#pragma multi_compile _ _GBUFFER_NORMALS_OCT

#include "../../RayTracing/SsrShadeSurface.hlsl"
#include "../../RayTracing/GlxPublishedHit.hlsl"
#include "SsrRayRequest.hlsl"

StructuredBuffer<R1Sample> _R1Original;
RWStructuredBuffer<GlxPublishedHit> _R2Hits;
TEXTURE2D(_SsrHitPointTexture);
float4 _SsrScreenSize; // xy size, zw inverse size
float4 _SsrTraceSize;  // xy trace size
uint _SsrHitLightCount;

#define SSR_HIT_FLAG 2u    // GlxHit
#define SSR_HIT_FLAG_SS 8u // C2 flags bit 3

[numthreads(8, 8, 1)]
void SsrHitSs(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (any(coord >= (uint2)_SsrTraceSize.xy))
        return;

    uint slot = coord.y * (uint)_SsrTraceSize.x + coord.x;
    R1Sample q = _R1Original[slot];
    if (q.ssShare <= 0.0)
        return; // no screen-space coverage: the probe/RT fill owns this pixel

    float2 hitUv = LOAD_TEXTURE2D(_SsrHitPointTexture, coord);
    if (hitUv.x > 1.0 || hitUv.y < 0.0)
        return; // the ray did not hit this frame

    uint2 hitPixel = (uint2)(saturate(hitUv) * _SsrScreenSize.xy);
    hitPixel = min(hitPixel, (uint2)_SsrScreenSize.xy - 1u);
    float depth = LOAD_TEXTURE2D(_CameraDepthTexture, hitPixel).x;
    if (depth == UNITY_RAW_FAR_CLIP_VALUE)
        return;

    half4 gbuffer0 = LOAD_TEXTURE2D(_GBuffer0, hitPixel);
    half4 gbuffer1 = LOAD_TEXTURE2D(_GBuffer1, hitPixel);
    half4 gbuffer2 = LOAD_TEXTURE2D(_GBuffer2, hitPixel);

    half3 rawNormal = CdUnpackNormal(gbuffer2.xyz);
    if (dot(rawNormal, rawNormal) < 1e-6h)
        return;
    half3 normalWS = normalize(rawNormal);

    float2 uv = (hitPixel + 0.5) * _SsrScreenSize.zw;
    float3 positionWS = ComputeWorldSpacePosition(uv, depth, unity_MatrixInvVP);
    if (!all(isfinite(positionWS)) || !all(isfinite(q.position)) || !all(isfinite(q.direction)))
        return;

    half3 albedo = gbuffer0.rgb;
    half reflectivity = gbuffer1.r;
    half metallic = MetallicFromReflectivity(reflectivity);
    half smoothness = gbuffer2.a;

    SsrHitSurface s;
    s.gb0 = float4(albedo, 1.0);
    s.gb1 = float4(normalWS, 1.0 - smoothness); // perceptual roughness
    s.gb2 = float4(lerp(kDielectricSpec.rgb, albedo, metallic), 0.0);
    s.gb3 = float4(0.0, 0.0, 0.0, 0.0); // GBuffer carries no raw emissive
    float distance = length(positionWS - q.position);
    s.misc = float4(distance, (float)SsrSurfaceTypeLit, (float)SsrHitSurfaceVersion, (float)SsrHitSurfaceSourceGbuffer);

    // The reflected surface is seen along the reversed reflection ray.
    float3 viewDirWS = -normalize(q.direction);
    SsrShadedSample sample = SsrShadeSurface(s, positionWS, viewDirWS, _SsrHitLightCount);
    if (!all(isfinite(sample.radiance)))
        return;

    GlxPublishedHit hit;
    hit.radiance = sample.radiance;
    hit.hitT = distance;
    hit.flags = SSR_HIT_FLAG | SSR_HIT_FLAG_SS;
    hit.mode = 0;
    _R2Hits[q.slot] = hit;
}
