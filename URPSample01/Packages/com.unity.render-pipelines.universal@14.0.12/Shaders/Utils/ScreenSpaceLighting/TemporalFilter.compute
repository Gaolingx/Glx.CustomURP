// Screen Space Global Illumination temporal filter.
// Ported from HDRP 14.0.12 Runtime/RenderPipeline/Raytracing/Shaders/Denoising/TemporalFilter.compute.
// Differences from the HDRP source:
// - the history carries the validity weight in alpha and the accumulated sample count in a separate
//   single channel texture, because the SSGI signal is radiance plus an explicit weight;
// - receiver/occluder motion rejection is not implemented (URP has no object-motion stencil bit on
//   every renderer path); the plan records this as a known limitation;
// - the previous normal buffer is not part of the Screen Space Lighting history, so history normals
//   are not compared. Position and previous-depth rejection remain.
#pragma kernel ValidateHistory
#pragma kernel TemporalAccumulation

#pragma multi_compile _ SSGI_NORMALS_OCT
#pragma multi_compile _ SSL_XR_ARRAY

#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/ScreenSpaceLighting/ScreenSpaceLightingCommon.hlsl"
#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/ScreenSpaceLighting/Denoising.hlsl"

#define SSGI_TEMPORAL_TILE_SIZE 8

#define SSGI_HISTORYREJECTION_DEPTH 0x1
#define SSGI_HISTORYREJECTION_REPROJECTION 0x2
#define SSGI_HISTORYREJECTION_PREVIOUS_DEPTH 0x4
#define SSGI_HISTORYREJECTION_POSITION 0x8
#define SSGI_HISTORYREJECTION_MOTION 0x20
#define SSGI_HISTORYREJECTION_COMBINED 0x2F

SSGI_TEXTURE2D_FLOAT(_SsgiDepthTexture);
SSGI_TEXTURE2D_FLOAT4(_SsgiNormalTexture);
SSGI_TEXTURE2D_FLOAT2(_SsgiMotionTexture);
SSGI_TEXTURE2D_FLOAT(_SsgiPreviousDepthTexture);
SSGI_TEXTURE2D_FLOAT4(_SsgiDenoiseInputTexture);
SSGI_TEXTURE2D_FLOAT4(_SsgiHistoryColorTexture);
SSGI_TEXTURE2D_FLOAT(_SsgiHistorySampleCountTexture);
SSGI_RW_TEXTURE2D_UINT(_SsgiValidationTextureRW);
SSGI_RW_TEXTURE2D_FLOAT4(_SsgiAccumulationTextureRW);
SSGI_RW_TEXTURE2D_FLOAT4(_SsgiOutputHistoryTextureRW);
SSGI_RW_TEXTURE2D_FLOAT(_SsgiOutputSampleCountTextureRW);

#define _SsgiHistoryValidity _SsgiRayMarchingParams2.z
#define _SsgiResolutionMultiplier _SsgiTemporalParams.x
#define _SsgiInvResolutionMultiplier _SsgiTemporalParams.y
#define _SsgiPixelSpreadAngleTangent _SsgiDenoiserParams.x

[numthreads(SSGI_TEMPORAL_TILE_SIZE, SSGI_TEMPORAL_TILE_SIZE, 1)]
void ValidateHistory(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 coord = dispatchThreadId.xy;
    if (any(coord >= (uint2)_SsgiScreenSize.xy))
        return;

    uint flags = 0;
    float depth = SSGI_LOAD(_SsgiDepthTexture, coord);

    if (SsgiIsBackgroundDepth(depth) || _SsgiHistoryValidity == 0.0)
    {
        flags = SSGI_HISTORYREJECTION_COMBINED;
        SSGI_STORE(_SsgiValidationTextureRW, coord, flags);
        return;
    }

    float2 motion = SSGI_LOAD(_SsgiMotionTexture, coord).xy;
    float2 currentUv = SsgiGetPixelUv(coord, _SsgiScreenSize.zw);
    float2 historyUv = currentUv - motion;

    if (historyUv.x < 0.0 || historyUv.x >= 1.0 || historyUv.y < 0.0 || historyUv.y >= 1.0)
    {
        flags = SSGI_HISTORYREJECTION_REPROJECTION | SSGI_HISTORYREJECTION_PREVIOUS_DEPTH |
                SSGI_HISTORYREJECTION_POSITION | SSGI_HISTORYREJECTION_MOTION;
        SSGI_STORE(_SsgiValidationTextureRW, coord, flags);
        return;
    }

    float historyDepth = SSGI_SAMPLE_LOD(_SsgiPreviousDepthTexture, s_ssgi_linear_clamp_sampler, historyUv, 0);
    if (SsgiIsBackgroundDepth(historyDepth))
    {
        flags = SSGI_HISTORYREJECTION_PREVIOUS_DEPTH | SSGI_HISTORYREJECTION_POSITION |
                SSGI_HISTORYREJECTION_MOTION;
        SSGI_STORE(_SsgiValidationTextureRW, coord, flags);
        return;
    }

    float3 normalWS = SsgiDecodeNormalSS(SSGI_LOAD(_SsgiNormalTexture, coord));
    float3 positionWS = SsgiReconstructPositionWS((float2)coord, depth);
    float3 historyPositionWS = ComputeWorldSpacePosition(historyUv, historyDepth, SSL_PREV_INV_VIEW_PROJ);

    float maxRadius = SsgiComputeMaxReprojectionWorldRadius(positionWS, normalWS, _SsgiPixelSpreadAngleTangent);
    if (length(historyPositionWS - positionWS) > maxRadius)
        flags |= SSGI_HISTORYREJECTION_POSITION;

    SSGI_STORE(_SsgiValidationTextureRW, coord, flags);
}

[numthreads(SSGI_TEMPORAL_TILE_SIZE, SSGI_TEMPORAL_TILE_SIZE, 1)]
void TemporalAccumulation(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 currentCoord = dispatchThreadId.xy;
    if (any(currentCoord >= (uint2)_SsgiTraceSize.xy))
        return;

    uint2 sourceCoord = (uint2)(currentCoord * _SsgiInvResolutionMultiplier);
    sourceCoord = min(sourceCoord, (uint2)_SsgiScreenSize.xy - 1u);

    float depth = SSGI_LOAD(_SsgiDepthTexture, sourceCoord);
    if (SsgiIsBackgroundDepth(depth))
    {
        SSGI_STORE(_SsgiAccumulationTextureRW, currentCoord, float4(0.0, 0.0, 0.0, 0.0));
        SSGI_STORE(_SsgiOutputHistoryTextureRW, currentCoord, float4(0.0, 0.0, 0.0, 0.0));
        SSGI_STORE(_SsgiOutputSampleCountTextureRW, currentCoord, 0.0);
        return;
    }

    float4 current = SSGI_LOAD(_SsgiDenoiseInputTexture, currentCoord);
    float2 motion = SSGI_LOAD(_SsgiMotionTexture, sourceCoord).xy;
    float2 currentUv = SsgiGetPixelUv(currentCoord, _SsgiTraceSize.zw);
    float2 historyUv = currentUv - motion * _SsgiResolutionMultiplier;

    float4 history = float4(0.0, 0.0, 0.0, 0.0);
    float sampleCount = 0.0;
    bool insideHistory = historyUv.x >= 0.0 && historyUv.x <= 1.0 && historyUv.y >= 0.0 && historyUv.y <= 1.0;
    if (insideHistory)
    {
        history = SSGI_SAMPLE_LOD(_SsgiHistoryColorTexture, s_ssgi_linear_clamp_sampler, historyUv, 0);
        history = max(history, 0.0);
        sampleCount = SSGI_SAMPLE_LOD(_SsgiHistorySampleCountTexture, s_ssgi_point_clamp_sampler, historyUv, 0);
    }

    uint validation = SSGI_LOAD(_SsgiValidationTextureRW, sourceCoord);
    bool historyInvalid = (_SsgiHistoryValidity < 1.0) || validation != 0 || !insideHistory;

    float accumulationFactor = 0.0;
    if (historyInvalid || sampleCount == 0.0)
    {
        accumulationFactor = 0.0;
        history = 0.0;
        sampleCount = 1.0;
    }
    else
    {
        accumulationFactor = sampleCount >= 8.0 ? 0.93 : (sampleCount / (sampleCount + 1.0));
        sampleCount = min(sampleCount + 1.0, 8.0);
    }

    float4 accumulated = current * (1.0 - accumulationFactor) + history * accumulationFactor;

    SSGI_STORE(_SsgiAccumulationTextureRW, currentCoord, accumulated);
    SSGI_STORE(_SsgiOutputHistoryTextureRW, currentCoord, accumulated);
    SSGI_STORE(_SsgiOutputSampleCountTextureRW, currentCoord, sampleCount);
}