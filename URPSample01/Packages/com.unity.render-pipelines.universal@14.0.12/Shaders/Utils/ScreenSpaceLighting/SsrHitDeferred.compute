// P1 hit shading: decode the reflection hit surface and light it with the same
// ClusteredDeferred kernel the raster path uses. Shadow quality is the frozen SHADOW_LOW
// decision: single-tap atlas samples, no screen-space shadows/cookies/light layers/SSAO/
// shadowmask. Without a world-space light cluster every additional light is visited, capped
// at 64 for the transition.
#pragma kernel SsrHitDeferred

#pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE
#pragma multi_compile _ _ADDITIONAL_LIGHT_SHADOWS

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/ClusteredDeferred.hlsl"
#include "../../RayTracing/GlxPublishedHit.hlsl"
#include "../../RayTracing/SsrHitSurface.hlsl"
#include "../../RayTracing/GlxProbeSampling.hlsl"
#include "SsrRayRequest.hlsl"

#define SSR_HIT_LIGHT_CAP 64u
#define SSR_HIT_FLAG 2u // == GlxHit in GlxBasicPayload.hlsl

StructuredBuffer<R1Sample> _R1Queue;
StructuredBuffer<uint> _R1Counts;
StructuredBuffer<SsrHitSurface> _R2Surfaces;
RWStructuredBuffer<GlxPublishedHit> _R2Hits;
uint _R2K;
uint _SsrHitLightCount;

[numthreads(64, 1, 1)]
void SsrHitDeferred(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= min(_R1Counts[2], _R2K)) return;

    SsrHitSurface s = _R2Surfaces[index];
    if (uint(s.misc.z + 0.5) != SsrHitSurfaceVersion) return; // keep the closest-hit radiance
    if (uint(s.misc.w + 0.5) != SsrHitSurfaceSourceRt) return;

    R1Sample q = _R1Queue[index];
    float distance = s.misc.x;
    if (!(distance > 0.0) || !all(isfinite(q.position)) || !all(isfinite(q.direction))) return;

    float3 direction = normalize(q.direction);
    float3 positionWS = q.position + direction * distance;
    float3 normalWS = normalize(s.gb1.xyz);
    half smoothness = half(1.0 - saturate(s.gb1.w));

    // Synthetic GBuffer, same encoding ClusteredDeferred decodes. gbuffer1 carries the
    // reflectivity the material published, and the packed flag word stays 0: receive
    // shadows, specular highlights on, neither subtractive nor specular-setup.
    uint materialType = 1u;
    half4 gbuffer0 = half4(s.gb0.rgb, 0.0);
    half4 gbuffer1 = half4(s.gb2.rgb, 0.0);
    half4 gbuffer2 = half4(normalWS, smoothness);

    CdInputData inputData;
    inputData.positionWS = positionWS;
    inputData.normalWS = normalWS;
    // The hit surface is seen along the reversed reflection ray, not from the camera.
    inputData.viewDirectionWS = half3(-direction);
    inputData.normalizedScreenSpaceUV = 0.0;

    half4 shadowMask = half4(1.0, 1.0, 1.0, 1.0);
    half3 color = 0.0;

    CdLight mainLight = CdMainLight(positionWS);
    mainLight.shadowAttenuation = CdMainLightShadow(
        CdTransformWorldToShadowCoord(positionWS, float2(0.0, 0.0)), positionWS, shadowMask, half4(1.0, 1.0, 1.0, 1.0));
    color += CdShade(materialType, gbuffer0, gbuffer1, gbuffer2, mainLight, inputData);

    uint lightCount = min(_SsrHitLightCount, SSR_HIT_LIGHT_CAP);
    [loop] for (uint i = 0; i < lightCount; ++i)
    {
        CdLight light = CdGetAdditionalLight(i, positionWS);
        light.shadowAttenuation = CdAdditionalLightShadow(i, positionWS, light.direction, shadowMask, half4(1.0, 1.0, 1.0, 1.0));
        color += CdShade(materialType, gbuffer0, gbuffer1, gbuffer2, light, inputData);
    }

    // Ambient: the probe low-frequency irradiance the closest-hit path already used. The
    // specular share reuses the same irradiance until P2 brings the probe/sky hierarchy.
    BRDFData brdf = CdBRDFDataFromGbuffer(gbuffer0, gbuffer1, gbuffer2);
    half3 ambientRadiance = half3(GlxHitLowFrequencyIrradiance(positionWS, normalWS)) * INV_PI;
    color += brdf.diffuse * ambientRadiance + brdf.fresnel0 * ambientRadiance + s.gb3.rgb;

    if (!all(isfinite(color))) return;
    GlxPublishedHit hit;
    hit.radiance = max(color, 0.0);
    hit.hitT = distance;
    hit.flags = SSR_HIT_FLAG;
    hit.mode = 0;
    _R2Hits[q.slot] = hit;
}
