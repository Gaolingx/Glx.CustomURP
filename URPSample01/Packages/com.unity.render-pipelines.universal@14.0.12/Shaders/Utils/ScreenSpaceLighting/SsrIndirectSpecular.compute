// P3 (B2, D1-A): deferred indirect-specular composite.
//
// The deferred Lit GBuffer pass now writes only emission + indirect diffuse into GBuffer3 (the
// _CdBakedColor the deferred kernel loads). This kernel rebuilds the indirect-specular term the
// GBuffer used to fold in: it decodes GBuffer0/1/2 + depth, reconstructs the reflection vector,
// samples the environment reflection and the opaque SSR result, blends them with the SSR coverage,
// and applies EnvironmentBRDFSpecular once. The result is multiplied by the surface occlusion
// (GBuffer1.a) so it matches the original EnvironmentBRDF * occlusion the deferred kernel used to
// receive. ClusteredDeferred adds this texture to the baked colour, so the environment reflection is
// sampled exactly once.
//
// Environment source (_SsrIndirectParams.z, SsrIndirectSource):
//   A1 = the per-camera _GlossyEnvironmentCubeMap (sky/default reflection), roughness mips;
//   A2 = the published GI probe atlas (directional irradiance x 1/pi, no roughness mips), blended
//        over the cubemap remainder by probe coverage. The query always compiles; the Setup pass
//        binds an invalid one-element snapshot when no generation is published, so GlxProbeQuery
//        returns false and A2 falls back to the cubemap;
//   A3 = the uniform _GlossyEnvironmentColor ambient, a pure fallback.
//
// Everything this kernel declares is bound by the pass; nothing relies on per-draw state.
#pragma kernel SsrIndirectSpecular

#pragma multi_compile _ _GBUFFER_NORMALS_OCT

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Packing.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/EntityLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/ImageBasedLighting.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/BRDF.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/RayTracing/GlxProbeQuery.hlsl"

TEXTURE2D(_GBuffer0);
TEXTURE2D(_GBuffer1);
TEXTURE2D(_GBuffer2);
TEXTURE2D(_CameraDepthTexture);
TEXTURE2D(_ScreenSpaceSsrTexture);

// A1 environment source: the per-camera reflection/sky fallback. Bound by URP every camera.
TEXTURECUBE(_GlossyEnvironmentCubeMap);
SAMPLER(sampler_GlossyEnvironmentCubeMap);
half4 _GlossyEnvironmentCubeMap_HDR;

// A3 fallback: the per-camera ambient glossy colour URP uploads every frame.
float4 _GlossyEnvironmentColor;

RWTexture2D<float4> _GlxSsrSpecularRW;

// Unity's per-camera globals are not declared by the core headers inside a compute include;
// the pipeline still uploads them (same pattern as ClusteredDeferred.hlsl and
// ScreenSpaceLightingCommon.hlsl).
float4x4 unity_MatrixInvVP;

// xy screen size, zw inverse screen size.
float4 _SsrIndirectScreenSize;
// xyz camera position (WS), w unused.
float4 _SsrIndirectCameraPos;
// x SSR intensity, y A2 probe coverage, z SsrIndirectSource (0 A1, 1 A2, 2 A3), w unused.
float4 _SsrIndirectParams;

#define SSR_INDIRECT_FLAG_SPECULAR_SETUP 8u

half3 SsrIndirectUnpackNormal(half3 packedNormalWS)
{
#ifdef _GBUFFER_NORMALS_OCT
    half2 remappedOctNormalWS = half2(Unpack888ToFloat2(packedNormalWS));
    half2 octNormalWS = remappedOctNormalWS * half(2.0) - half(1.0);
    return half3(UnpackNormalOctQuadEncode(octNormalWS));
#else
    return packedNormalWS;
#endif
}

// Mirrors ClusteredDeferred's CdBRDFDataFromGbuffer so the composite reproduces the exact BRDF the
// kernel (and the original EnvironmentBRDF in the GBuffer pass) would have used.
BRDFData SsrIndirectBRDFFromGbuffer(half3 albedo, half3 packedSpecular, half smoothness, uint materialFlags)
{
    BRDFData brdfData = (BRDFData)0;
    half alpha = half(1.0);
    half3 brdfDiffuse;
    half3 brdfSpecular;
    half reflectivity;
    half oneMinusReflectivity;

    if ((materialFlags & SSR_INDIRECT_FLAG_SPECULAR_SETUP) != 0u)
    {
        reflectivity = ReflectivitySpecular(packedSpecular);
        oneMinusReflectivity = half(1.0) - reflectivity;
        brdfDiffuse = albedo * oneMinusReflectivity;
        brdfSpecular = packedSpecular;
    }
    else
    {
        reflectivity = packedSpecular.r;
        oneMinusReflectivity = 1.0 - reflectivity;
        half metallic = MetallicFromReflectivity(reflectivity);
        brdfDiffuse = albedo * oneMinusReflectivity;
        brdfSpecular = lerp(kDielectricSpec.rgb, albedo, metallic);
    }

    InitializeBRDFDataDirect(albedo, brdfDiffuse, brdfSpecular, reflectivity, oneMinusReflectivity, smoothness, alpha, brdfData);
    return brdfData;
}

// A1: per-camera sky/default reflection cubemap with the material roughness mip.
half3 SsrIndirectSampleSky(float3 reflectVector, half perceptualRoughness)
{
    half mip = PerceptualRoughnessToMipmapLevel(perceptualRoughness);
    half4 encodedEnv = SAMPLE_TEXTURECUBE_LOD(_GlossyEnvironmentCubeMap, sampler_GlossyEnvironmentCubeMap, reflectVector, mip);
    return DecodeHDREnvironment(encodedEnv, _GlossyEnvironmentCubeMap_HDR);
}

// Selects the environment reflection for the receiver. The probe atlas carries directional
// irradiance only (no roughness mips, no box projection), so A2 approximates glossy reflections
// from the mirror direction and keeps the cubemap as the uncovered remainder.
half3 SsrIndirectEnvironment(float3 positionWS, float3 reflectVector, half perceptualRoughness)
{
    uint source = (uint)(_SsrIndirectParams.z + 0.5h);
    // A3 never samples the cubemap: the uniform ambient is the whole term.
    if (source == 2u)
        return _GlossyEnvironmentColor.rgb;
    half3 sky = SsrIndirectSampleSky(reflectVector, perceptualRoughness);
    if (source == 1u)
    {
        half3 irradiance;
        if (GlxProbeQuery(positionWS, reflectVector, irradiance))
        {
            half3 probeRadiance = max(irradiance, 0.0h) * INV_PI;
            return lerp(sky, probeRadiance, saturate(_SsrIndirectParams.y));
        }
    }
    return sky;
}

[numthreads(16, 16, 1)]
void SsrIndirectSpecular(uint3 id : SV_DispatchThreadID)
{
    uint2 pixel = id.xy;
    if (any(pixel >= (uint2)_SsrIndirectScreenSize.xy))
        return;

    float rawDepth = LOAD_TEXTURE2D(_CameraDepthTexture, pixel).x;
    if (rawDepth == UNITY_RAW_FAR_CLIP_VALUE)
    {
        _GlxSsrSpecularRW[pixel] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    half4 gbuffer0 = LOAD_TEXTURE2D(_GBuffer0, pixel);
    half4 gbuffer1 = LOAD_TEXTURE2D(_GBuffer1, pixel);
    half4 gbuffer2 = LOAD_TEXTURE2D(_GBuffer2, pixel);

    float2 uv = (pixel + 0.5) * _SsrIndirectScreenSize.zw;
    float3 positionWS = ComputeWorldSpacePosition(uv, rawDepth, unity_MatrixInvVP);
    half3 rawNormal = SsrIndirectUnpackNormal(gbuffer2.xyz);
    // Pixels with no written GBuffer (e.g. forward-only geometry seen through the opaque prepass
    // depth) have a zero normal; skip them so a normalize(0) never writes NaN into the target.
    if (dot(rawNormal, rawNormal) < 1e-6h)
    {
        _GlxSsrSpecularRW[pixel] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }
    half3 normalWS = normalize(rawNormal);
    float3 viewDirWS = normalize(_SsrIndirectCameraPos.xyz - positionWS);
    half3 reflectVector = reflect(-viewDirWS, normalWS);

    half NoV = saturate(dot(normalWS, viewDirWS));
    half fresnelTerm = Pow4(1.0 - NoV);

    uint materialFlags = uint(gbuffer0.a * 255.0h + 0.5h);
    half occlusion = gbuffer1.a;
    BRDFData brdfData = SsrIndirectBRDFFromGbuffer(gbuffer0.rgb, gbuffer1.rgb, gbuffer2.a, materialFlags);

    half3 environmentSpecular = SsrIndirectEnvironment(positionWS, reflectVector, brdfData.perceptualRoughness);

    half4 ssr = LOAD_TEXTURE2D(_ScreenSpaceSsrTexture, pixel);
    half weight = saturate(ssr.a * max(_SsrIndirectParams.x, 0.0h));
    half3 indirectSpecular = lerp(environmentSpecular, max(ssr.rgb, half3(0.0, 0.0, 0.0)), weight);

    half3 specular = indirectSpecular * EnvironmentBRDFSpecular(brdfData, fresnelTerm);
    half3 result = specular * occlusion;
    _GlxSsrSpecularRW[pixel] = float4(result, 1.0);
}
