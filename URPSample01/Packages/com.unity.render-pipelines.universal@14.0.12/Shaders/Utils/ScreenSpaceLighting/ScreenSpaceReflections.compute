// Opaque Screen Space Reflections: trace and reproject for both algorithms.
// Ported from HDRP 14.0.12 Runtime/Lighting/ScreenSpaceLighting/ScreenSpaceReflections.compute.
//
// The PBR signal written by the reprojection is consumed by the reflection denoiser
// (Shaders/Utils/Denoising/ReflectionDenoiser.compute), which owns the temporal accumulation and the
// bilateral filter. This file traces, reprojects, merges the hardware reflection fill and exposes
// the parameter debug view.
//
// Differences from HDRP:
// - URP has no SSR stencil bit. The depth-normals alpha carries the material smoothness, so
//   unsupported materials keep weight 0 instead of being filtered by stencil.
// - The result is un-premultiplied radiance in rgb plus the blend weight in a. HDRP accumulates
//   radiance * weight; the URP material blend applies lerp(probe, radiance, weight) so the probe
//   keeps its (1 - weight) share and the BRDF is evaluated exactly once.
// - The previous frame color pyramid is the SSL private linear HDR history (no pre-exposure).
// - SSR marches the actual packed depth chain: the pass uploads the built mip count (capped at 14)
//   in _SsrPyramidParams.y. SSGI keeps the shared helper's mip 6 clamp.
// - Reflection samples come from the same blue-noise distributed Owen scrambled Sobol sequence as
//   HDRP (1SPP tiles), with the IGN + R2 sequence as the fallback when the LUTs are missing.
// - SSS sample weights use the world-space normal for the GGX lambda terms; HDRP evaluates the
//   lambda terms with world-space vectors as if they were in the local frame.
#pragma kernel ScreenSpaceReflectionsTracing                  SSR_TRACE
#pragma kernel ScreenSpaceReflectionsReprojection             SSR_REPROJECT
#pragma kernel DebugSsrParams
#pragma kernel R1Original SSR_R1_HISTORY
#pragma kernel R1Cold SSR_R1_COLD
#pragma kernel R1Tiles
#pragma kernel R1Offsets
#pragma kernel R1Scatter
#pragma kernel R2Clear
#pragma kernel R2Composite SSR_R2_COMPOSITE
#pragma kernel R2CompositeCold SSR_R2_COLD
#pragma kernel R2Temporal SSR_R2_TEMPORAL
#pragma kernel SsrPbrHwMerge SSR_PBR_MERGE

#pragma multi_compile _ SSR_APPROX
#pragma multi_compile _ SSR_HALF_RES
#pragma multi_compile _ SSR_NORMALS_OCT
#pragma multi_compile _ SSL_XR_ARRAY
#pragma multi_compile _ SSGI_BLUE_NOISE

#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/ScreenSpaceLighting/ScreenSpaceLightingCommon.hlsl"
#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/ScreenSpaceLighting/Sampling.hlsl"
#include "Packages/com.unity.render-pipelines.universal/Shaders/Utils/ScreenSpaceLighting/RayMarching.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/CommonLighting.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/BSDF.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/ImageBasedLighting.hlsl"

#define SSR_TILE_SIZE 8
#define _SsrDepthPyramidMaxMip (int)_SsrPyramidParams.y
#define SSR_TRACE_EPS 0.000488281f
#define SSR_MISS_SENTINEL 99.0
#define MIN_GGX_ROUGHNESS 0.00001f
#define MAX_GGX_ROUGHNESS 0.99999f
#define SSR_BLOCK_SAMPLE_RADIUS 1

// Full resolution inputs.
SSGI_TEXTURE2D_FLOAT(_SsrDepthTexture);
SSGI_TEXTURE2D_FLOAT4(_SsrNormalTexture);
SSGI_TEXTURE2D_FLOAT2(_SsrMotionTexture);

// Previous frame color pyramid, captured after transparents by the SSL history pass.
SSGI_TEXTURE2D_FLOAT4(_SsrColorPyramid);

// Trace output: ndc of the hit point, or (99, 0) for a miss.
#if defined(SSR_TRACE)
SSGI_RW_TEXTURE2D_FLOAT2(_SsrHitPointTextureRW);
#elif defined(SSR_REPROJECT) || defined(SSR_R1_HISTORY) || defined(SSR_R2_COMPOSITE)
SSGI_TEXTURE2D_FLOAT2(_SsrHitPointTextureRW);
#endif
// Approximation output: rgb = radiance, a = blend weight.
SSGI_RW_TEXTURE2D_FLOAT4(_SsrOutputTextureRW);

// Hardware reflection fill: the resolved DXR radiance history at trace resolution. The temporal
// kernel writes it, the composite point-expands it into the full resolution output, and the PBR
// merge folds it into the reprojection signal before the reflection denoiser.
#if defined(SSR_R2_COMPOSITE) || defined(SSR_R2_COLD) || defined(SSR_R2_TEMPORAL) || defined(SSR_PBR_MERGE)
SSGI_TEXTURE2D_FLOAT4(_SsrHwHistory);
#endif
// PBR merge input: this frame's reprojection at trace resolution. It is a separate texture so the
// merge can read the screen-space signal and write the combined one.
#if defined(SSR_PBR_MERGE)
SSGI_TEXTURE2D_FLOAT4(_SsrMergeSource);
#endif
#if defined(SSR_R2_TEMPORAL)
SSGI_RW_TEXTURE2D_FLOAT4(_SsrHwHistoryRW);
// Previous frame depth/normals, captured with the color history at full resolution. The encoding
// matches the current prepass, so the same decode is reused.
SSGI_TEXTURE2D_FLOAT(_HistoryDepthTexture);
SSGI_TEXTURE2D_FLOAT4(_HistoryNormalTexture);
float _SsrHwHistoryValid;
#endif

// PBR reprojection output, consumed by the reflection denoiser.
SSGI_RW_TEXTURE2D_FLOAT4(_SsrReprojectTextureRW);

#define _SsrIterLimit (int)_SsrRayMarchingParams.x
#define _SsrThicknessScale _SsrRayMarchingParams.y
#define _SsrThicknessBias _SsrRayMarchingParams.z
#define _SsrReflectsSky (_SsrRayMarchingParams.w != 0)

#define _SsrRoughnessFadeRcpLength _SsrRoughnessFadeParams.x
#define _SsrRoughnessFadeEndTimesRcpLength _SsrRoughnessFadeParams.y
#define _SsrRoughnessFadeEnd _SsrRoughnessFadeParams.z
#define _SsrEdgeFadeRcpLength _SsrRoughnessFadeParams.w

#define _SsrColorPyramidMaxMip _SsrPyramidParams.x

#define _SsrPBRBias _SsrPbrParams.y
#define _SsrFrameIndex (int)_SsrPbrFlags.x

// The Approximation reproject writes the material-facing texture directly; the PBR path writes the
// un-accumulated signal consumed by the reflection denoiser.
#if defined(SSR_APPROX)
    #define SSR_APPROX_OUTPUT _SsrOutputTextureRW
#else
    #define SSR_APPROX_OUTPUT _SsrReprojectTextureRW
#endif

// The shared SsgiReconstructPositionWS reads _SsgiScreenSize, which only exists in the SSGI constant
// buffer. Both compute shaders include the same header, so the SSR kernels must scale with their own
// upload instead of reading an SSGI field this shader never receives (it would be zero).
float3 SsrReconstructPositionWS(float2 positionSS, float deviceDepth)
{
    float2 uv = (positionSS + 0.5) * _SsrScreenSize.zw;
    return ComputeWorldSpacePosition(uv, deviceDepth, SSL_INV_VIEW_PROJ);
}

// Maps a trace resolution pixel to the full resolution pixel that owns its depth, normal and motion.
// Both algorithms can trace at half the screen size. HDRP's ray traced reflection denoiser reads the
// top-left pixel of the 2x2 group (coord * 2), so this helper yields 2c in the half resolution path.
uint2 SsrGetFullResCoord(uint2 traceCoord)
{
#if defined(SSR_HALF_RES)
    return SslComputeSourceCoordinates(traceCoord, _SsrScreenSize.xy, _SsrTraceSize.xy);
#else
    return traceCoord;
#endif
}

float3 SsrDecodeNormalSS(float4 normalBuffer)
{
#if defined(SSR_NORMALS_OCT)
    float2 remappedOctNormalWS = Unpack888ToFloat2(normalBuffer.rgb);
    return UnpackNormalOctQuadEncode(remappedOctNormalWS * 2.0 - 1.0);
#else
    float3 rawNormalWS = normalBuffer.rgb;
    float lenSq = dot(rawNormalWS, rawNormalWS);
    return lenSq > 1e-8 ? rawNormalWS * rsqrt(lenSq) : float3(0.0, 0.0, 0.0);
#endif
}

// Returns false for materials that do not provide a valid normal/smoothness pair. The depth-normals
// alpha uses 0.5 + 0.5 * smoothness in both paths: on Deferred the SSR pass runs before the GBuffer
// overwrites GBuffer2, so it reads the same encoded prepass value Forward reads. Zero marks an
// unsupported material (Unlit, SimpleLit, custom shaders).
bool SsrDecodeMaterial(float4 normalSample, out float3 normalWS, out float perceptualRoughness)
{
    normalWS = SsrDecodeNormalSS(normalSample);
    float encodedSmoothness = normalSample.a;
    if (encodedSmoothness <= 0.0)
    {
        perceptualRoughness = 1.0;
        return false;
    }

    float smoothness = saturate(encodedSmoothness * 2.0 - 1.0);
    perceptualRoughness = 1.0 - smoothness;
    return dot(normalWS, normalWS) > 0.5;
}

float SsrLambdaGGX(float roughness, float cosTheta)
{
    cosTheta = max(1e-4, abs(cosTheta));
    return 0.5 * (sqrt(1.0 + (roughness * roughness) * (1.0 - cosTheta * cosTheta) / (cosTheta * cosTheta)) - 1.0);
}

// Value over pdf for a GGX reflection sample (Fresnel excluded).
float SsrGetSampleWeight(float NdotV, float NdotL, float roughness)
{
    float lambdaVPlusOne = SsrLambdaGGX(roughness, NdotV) + 1.0;
    float lambdaL = SsrLambdaGGX(roughness, NdotL);
    return lambdaVPlusOne / (lambdaVPlusOne + lambdaL);
}

// Local-frame variant used by the trace, where localV.z and localL.z are the cosine terms.
float SsrGetSampleWeightLocal(float3 localV, float3 localL, float roughness)
{
    return SsrGetSampleWeight(localV.z, localL.z, roughness);
}

// Isotropic GGX visible normal sampling. Returns false when the sample is below the surface or its
// contribution is negligible.
bool SsrSampleGGX_VNDF(float roughness, float3x3 localToWorld, float3 V, float2 inputSample,
    out float3 outgoingDir, out float weight)
{
    weight = 0.0;
    float clampedRoughness = clamp(roughness, MIN_GGX_ROUGHNESS, MAX_GGX_ROUGHNESS);

    float VdotH;
    float3 localV;
    float3 localH;
    SampleGGXVisibleNormal(inputSample, V, localToWorld, clampedRoughness, localV, localH, VdotH);

    float3 localL = 2.0 * VdotH * localH - localV;
    outgoingDir = mul(localL, localToWorld);

    if (localL.z < 0.001)
        return false;

    weight = SsrGetSampleWeightLocal(localV, localL, clampedRoughness);
    return weight >= 0.001;
}

// Reconstructs the previous frame uv and samples the color pyramid with the roughness mip. Returns
// the un-premultiplied radiance and the fade weight; an invalid sample returns opacity 0.
float3 SsrReadOriginalColor(float2 hitPositionNDC, float perceptualRoughness, out float opacity, out float edge, out bool accepted)
{
    uint2 hitPixel = (uint2)(saturate(hitPositionNDC) * _SsrScreenSize.xy);
    hitPixel = min(hitPixel, (uint2)_SsrScreenSize.xy - 1u);
    float2 motion = SSGI_LOAD(_SsrMotionTexture, hitPixel).xy;
    float2 prevFrameNDC = hitPositionNDC - motion;
    float2 prevPyramidUv = prevFrameNDC * _SsrColorPyramidScaleAndLimitPrev.xy;

    float mipLevel = lerp(0.0, _SsrColorPyramidMaxMip, perceptualRoughness);
    float2 diffLimit = _SsrColorPyramidScaleAndLimitPrev.xy - _SsrColorPyramidScaleAndLimitPrev.zw;
    float2 diffLimitMipAdjusted = diffLimit * pow(2.0, 1.5 + ceil(abs(mipLevel)));
    float2 limit = _SsrColorPyramidScaleAndLimitPrev.xy - diffLimitMipAdjusted;

    accepted = false;
    edge = 0.0;
    opacity = 0.0;
    if (any(prevFrameNDC < 0.0) || any(prevFrameNDC > limit))
        return 0.0;

    edge = EdgeOfScreenFade(prevFrameNDC, _SsrEdgeFadeRcpLength);
    opacity = edge * PerceptualRoughnessFade(perceptualRoughness, _SsrRoughnessFadeRcpLength, _SsrRoughnessFadeEndTimesRcpLength);

    float3 color = SSGI_SAMPLE_LOD(_SsrColorPyramid, s_ssgi_linear_clamp_sampler, prevPyramidUv, mipLevel).rgb;
    bool colorValid = IsFinite(color.r) && IsFinite(color.g) && IsFinite(color.b) && all(color >= 0.0);
    if (!colorValid)
    {
        opacity = 0.0;
        return 0.0;
    }

    accepted = true;
    return color;
}

float3 SsrSamplePreviousColor(float2 uv, float roughness, out float opacity)
{
    float edge; bool accepted;
    return SsrReadOriginalColor(uv, roughness, opacity, edge, accepted);
}

bool SsrOriginalDirection(uint2 traceCoord, float3 normalWS, float3 viewWS, float perceptualRoughness, out float3 reflectDir)
{
#if defined(SSR_APPROX)
    reflectDir = reflect(-viewWS, normalWS);
    return true;
#else
    float roughness = clamp(PerceptualRoughnessToRoughness(perceptualRoughness), MIN_GGX_ROUGHNESS, MAX_GGX_ROUGHNESS);
    float2 Xi = float2(SsgiGetSequenceSample(traceCoord, _SsrFrameIndex, 0), SsgiGetSequenceSample(traceCoord, _SsrFrameIndex, 1));
    Xi.x = lerp(Xi.x, 0.0, _SsrPBRBias);
    float weight;
    bool valid = SsrSampleGGX_VNDF(roughness, GetLocalFrame(normalWS), viewWS, Xi, reflectDir, weight);
    return valid && dot(normalWS, reflectDir) >= 0.001;
#endif
}

#include "SsrRequestQueue.hlsl"

// Matches the 24-byte GlxBasicPayload; no AS declaration in compute variants.
struct R2Hit { float3 radiance; float hitT; uint flags, mode; };
RWStructuredBuffer<R2Hit> _R2Hits;

[numthreads(8,8,1)]
void R2Clear(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_SsrTraceSize.xy)) return;
    _R2Hits[id.y * (uint)_SsrTraceSize.x + id.x] = (R2Hit)0;
}

#if defined(SSR_R2_COMPOSITE) || defined(SSR_R2_COLD)
[numthreads(8,8,1)]
#if defined(SSR_R2_COLD)
void R2CompositeCold(uint3 id : SV_DispatchThreadID)
#else
void R2Composite(uint3 id : SV_DispatchThreadID)
#endif
{
    SSGI_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_SsrScreenSize.xy)) return;
#if defined(SSR_R2_COLD)
    SSGI_STORE(_SsrOutputTextureRW, id.xy, 0);
#endif
    // Point-expand each original sample, including the last odd-size footprint. Never
    // use spatially filtered RGB/alpha as SS evidence or spread HW into another slot.
    uint2 coord = ((id.xy + 1u) * (uint2)_SsrTraceSize.xy - 1u) / (uint2)_SsrScreenSize.xy;
    uint slot = coord.y * (uint)_SsrTraceSize.x + coord.x;
    R1Sample q = _R1Original[slot];
    if (q.reason < 2u) return; // outside the hybrid domain: preserve regular SSR
    float4 n = SSGI_LOAD(_SsrNormalTexture, id.xy);
    float3 normal; float roughness;
    float depth = SSGI_LOAD(_SsrDepthTexture, id.xy);
    if (!isfinite(depth) || !all(isfinite(n)) || SsgiIsBackgroundDepth(depth) || n.a < 0.825 || !SsrDecodeMaterial(n, normal, roughness) ||
        abs(roughness-q.roughness) > 0.02 || dot(normal,q.normal) < 0.95 || roughness > _SsrRoughnessFadeEnd) return;
    float3 position = SsrReconstructPositionWS(id.xy, depth);
    if (abs(dot(position - q.position, q.normal)) > max(0.002, 0.001 * distance(q.position, SSL_SSR_CAMERA_POSITION_WS))) return;

    float s = saturate(q.ssShare);
    float3 ss = 0;
#if defined(SSR_R2_COMPOSITE)
    if (s > 0) ss = SsrSamplePreviousColor(SSGI_LOAD(_SsrHitPointTextureRW,coord),q.roughness,s);
#endif
    // The temporal kernel already merged this frame's hits with the reused history; a weight of
    // zero means the ray neither resolved now nor had a reusable previous result.
    float4 hwSample = SSGI_LOAD(_SsrHwHistory, coord);
    bool resolved = hwSample.a > 0.0 && all(isfinite(hwSample.rgb)) && all(hwSample.rgb >= 0.0);
    // The stored share is clamped by this frame's roughness/edge fade so a material change cannot
    // keep a stale coverage.
    float hw = resolved ? min(min(1.0 - s, q.requestShare), hwSample.a) : 0;
    float a = s + hw;
    float3 sum = s * ss;
    if (hw > 0) sum += hw * hwSample.rgb;
    SSGI_STORE(_SsrOutputTextureRW, id.xy, float4(a > 0 ? sum / a : float3(0,0,0), a));
}
#endif

//--------------------------------------------------------------------------------------------------
// Hardware fill temporal reuse (Approximation and PBR hybrid)
//--------------------------------------------------------------------------------------------------
// Runs at trace resolution between DispatchRays and the consumer (the Approximation composite or
// the PBR merge). Served samples publish their resolved radiance; unserved samples reproject the
// previous result and reuse it only while the receiver surface still matches. A served finite miss
// clears the pixel (the ray really found nothing), and pixels outside the hybrid domain are cleared
// so a later re-entry starts fresh.
#if defined(SSR_R2_TEMPORAL)
[numthreads(8,8,1)]
void R2Temporal(uint3 id : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(id.z);
    if (any(id.xy >= (uint2)_SsrTraceSize.xy)) return;

    uint slot = id.y * (uint)_SsrTraceSize.x + id.x;
    R1Sample q = _R1Original[slot];
    R2Hit hit = _R2Hits[slot];

    float3 radiance = 0.0;
    float weight = 0.0;

    if (hit.flags != 0u)
    {
        bool resolved = (hit.flags & 2u) != 0u && hit.hitT >= q.tMin && hit.hitT <= q.tMax &&
            all(isfinite(hit.radiance)) && all(hit.radiance >= 0.0);
        if (resolved)
        {
            radiance = hit.radiance;
            weight = min(1.0 - saturate(q.ssShare), q.requestShare);
        }
    }
    else if (q.reason >= 2u && q.requestShare > 0.0 && _SsrHwHistoryValid > 0.5)
    {
        uint2 src = SsrGetFullResCoord(id.xy);
        float depth = SSGI_LOAD(_SsrDepthTexture, src);
        float4 n = SSGI_LOAD(_SsrNormalTexture, src);
        float3 normal; float roughness;
        if (isfinite(depth) && !SsgiIsBackgroundDepth(depth) && all(isfinite(n)) && n.a >= 0.825 &&
            SsrDecodeMaterial(n, normal, roughness) && roughness <= _SsrRoughnessFadeEnd)
        {
            float2 motion = SSGI_LOAD(_SsrMotionTexture, src).xy;
            float2 historyUv = SsgiGetPixelUv(src, _SsrScreenSize.zw) - motion;
            float2 historyTap = historyUv * (float2)_SsrTraceSize.xy;
            if (all(historyTap >= 0.0) && all(historyTap < (float2)_SsrTraceSize.xy))
            {
                float historyDepth = SSGI_SAMPLE_LOD(_HistoryDepthTexture, s_ssgi_linear_clamp_sampler, historyUv, 0);
                float4 historyN = SSGI_SAMPLE_LOD(_HistoryNormalTexture, s_ssgi_point_clamp_sampler, historyUv, 0);
                float3 historyNormal; float historyRoughness;
                if (!SsgiIsBackgroundDepth(historyDepth) && historyN.a >= 0.825 &&
                    SsrDecodeMaterial(historyN, historyNormal, historyRoughness) &&
                    dot(normal, historyNormal) > 0.95 && abs(roughness - historyRoughness) < 0.02)
                {
                    float3 positionWS = SsrReconstructPositionWS((float2)src, depth);
                    float3 historyWS = ComputeWorldSpacePosition(historyUv, historyDepth, SSL_PREV_INV_VIEW_PROJ);
                    float maxRadius = max(0.002, 0.01 * distance(positionWS, SSL_SSR_CAMERA_POSITION_WS));
                    if (distance(historyWS, positionWS) <= maxRadius)
                    {
                        float4 history = SSGI_LOAD(_SsrHwHistory, (uint2)historyTap);
                        if (history.a > 0.0 && all(isfinite(history.rgb)) && all(history.rgb >= 0.0))
                        {
                            radiance = history.rgb;
                            weight = history.a;
                        }
                    }
                }
            }
        }
    }

    SSGI_STORE(_SsrHwHistoryRW, id.xy, float4(radiance, weight));
}
#endif

//--------------------------------------------------------------------------------------------------
// PBR hardware merge
//--------------------------------------------------------------------------------------------------
// Folds the resolved hardware fill into the reprojection signal at trace resolution, so the
// reflection denoiser sees one sample per pixel exactly as in the SS-only path. The SS sample and
// the hardware ray are samples of the same GGX lobe: R1 re-derives the trace direction from the
// same blue-noise sequence, so a missed screen-space ray keeps its receiver fade and the remaining
// share comes from the hardware history. Coverage and radiance follow the same non-premultiplied
// contract as R2Composite; the difference is only where the merge happens (before the PBR temporal
// accumulation instead of after the upsample) because the denoiser owns the history.
#if defined(SSR_PBR_MERGE)
[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void SsrPbrHwMerge(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 coord = dispatchThreadId.xy;
    if (any(coord >= (uint2)_SsrTraceSize.xy)) return;

    uint slot = coord.y * (uint)_SsrTraceSize.x + coord.x;
    R1Sample q = _R1Original[slot];

    float4 ss = SSGI_LOAD(_SsrMergeSource, coord);
    float s = saturate(ss.a);

    float4 hwSample = SSGI_LOAD(_SsrHwHistory, coord);
    bool resolved = hwSample.a > 0.0 && all(isfinite(hwSample.rgb)) && all(hwSample.rgb >= 0.0);
    // Outside the hybrid domain (invalid material, roughness fade, full screen-space coverage) the
    // request share is zero, so the merge leaves the screen-space sample untouched.
    float hw = (q.reason >= 2u && q.requestShare > 0.0 && resolved)
        ? min(min(1.0 - s, q.requestShare), hwSample.a)
        : 0.0;

    float a = s + hw;
    // A zero share must never multiply a non-finite history sample: 0 * NaN poisons the sum.
    float3 radiance = float3(0.0, 0.0, 0.0);
    if (a > 0.0)
    {
        radiance = s * max(ss.rgb, 0.0);
        if (hw > 0.0)
            radiance += hw * hwSample.rgb;
        radiance /= a;
    }
    SSGI_STORE(_SsrOutputTextureRW, coord, float4(radiance, a));
}
#endif

//--------------------------------------------------------------------------------------------------
// Trace
//--------------------------------------------------------------------------------------------------

#if defined(SSR_TRACE)
[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void ScreenSpaceReflectionsTracing(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 traceCoord = dispatchThreadId.xy;
    if (any(traceCoord >= (uint2)_SsrTraceSize.xy)) return;
    uint2 inputCoord = SsrGetFullResCoord(traceCoord);
    float2 hitUv = float2(SSR_MISS_SENTINEL, 0.0);

    float deviceDepth = SSGI_LOAD(_SsrDepthTexture, inputCoord);
    float4 normalSample = SSGI_LOAD(_SsrNormalTexture, inputCoord);
    float3 normalWS;
    float perceptualRoughness;
    bool materialValid = SsrDecodeMaterial(normalSample, normalWS, perceptualRoughness);

    if (!SsgiIsBackgroundDepth(deviceDepth) && materialValid)
    {
        float3 positionWS = SsrReconstructPositionWS((float2)inputCoord, deviceDepth);
        float3 camPosWS = SSL_SSR_CAMERA_POSITION_WS;
        float3 viewWS = normalize(camPosWS - positionWS);

        // Normal bias with a distance dependent magnitude, matching HDRP. The shading normal is the
        // only normal available here, which is a known limitation of screen-space tracing.
        positionWS = camPosWS + (positionWS - camPosWS) * (1.0 - 0.001 * rcp(max(dot(normalWS, viewWS), FLT_EPS)));
        deviceDepth = ComputeNormalizedDeviceCoordinatesWithZ(positionWS, SSL_VIEW_PROJ).z;

        bool killRay = deviceDepth == UNITY_RAW_FAR_CLIP_VALUE;
        killRay = killRay || (dot(normalWS, viewWS) <= 0.0);
        killRay = killRay || (perceptualRoughness > _SsrRoughnessFadeEnd);

        float3 reflectDir;
        bool validDirection = SsrOriginalDirection(traceCoord, normalWS, viewWS, perceptualRoughness, reflectDir);
        killRay = killRay || !validDirection;

        float3 rayPos;
        bool hit = SslRayMarch(
            positionWS,
            reflectDir,
            (float2)inputCoord,
            deviceDepth,
            killRay,
            _SsrIterLimit,
            _SsrThicknessScale,
            _SsrThicknessBias,
            _SsrReflectsSky,
            _SsrDepthPyramidMaxMip,
            _SsrScreenSize,
            rayPos);

        if (hit)
            hitUv = floor(rayPos.xy) * _SsrScreenSize.zw + 0.5 * _SsrScreenSize.zw;
    }

    SSGI_STORE(_SsrHitPointTextureRW, traceCoord, hitUv);
}
#elif defined(SSR_REPROJECT)

//--------------------------------------------------------------------------------------------------
// Reproject
//--------------------------------------------------------------------------------------------------

// Approximation hole filling. A single mirror tap leaves one pixel holes wherever the ray misses,
// which reads as broken reflections on smooth floors. Fill a missed receiver pixel from the same 3x3
// cross HDRP's PBR reprojection gathers, but only accept neighbours that
// - belong to the same surface (world position within a few pixels and a similar normal), so a
//   silhouette or a depth step never borrows radiance from the geometry behind it,
// - are eligible for SSR themselves, so a rough pixel stays below the fade,
// - produced their own valid hit.
// The filled weight is the accepted coverage times the neighbours' fade, so a filled hole stays
// partial and a region where every ray misses still keeps the reflection probe. The neighbourhood is
// walked in trace space; at half resolution one neighbour step equals two full resolution pixels.
bool SsrFillMissedPixel(uint2 traceCoord, uint2 centerCoord, float centerDepth, float3 centerNormalWS, float centerRoughness,
    out float3 radiance, out float opacity)
{
    radiance = 0.0;
    opacity = 0.0;

    float3 centerWS = SsrReconstructPositionWS((float2)centerCoord, centerDepth);
    float viewDistance = length(centerWS - SSL_SSR_CAMERA_POSITION_WS);
    float positionTolerance = 0.01 * viewDistance;

    float3 outputs = 0.0;
    float weightSum = 0.0;
    float opacitySum = 0.0;

    for (int y = -SSR_BLOCK_SAMPLE_RADIUS; y <= SSR_BLOCK_SAMPLE_RADIUS; ++y)
    {
        for (int x = -SSR_BLOCK_SAMPLE_RADIUS; x <= SSR_BLOCK_SAMPLE_RADIUS; ++x)
        {
            if (abs(x) == abs(y) && abs(x) == 1)
                continue;

            // The hit point texture follows the trace resolution, so the neighbourhood is walked in
            // trace space. A half resolution neighbour maps to the top-left full resolution pixel
            // of its 2x2 group for the surface acceptance tests.
            int2 neighborTrace = int2(traceCoord) + int2(x, y);
            if (neighborTrace.x < 0 || neighborTrace.y < 0 ||
                neighborTrace.x >= (int)_SsrTraceSize.x || neighborTrace.y >= (int)_SsrTraceSize.y)
                continue;

            uint2 neighborTraceSS = (uint2)neighborTrace;
            float2 neighborHit = SSGI_LOAD(_SsrHitPointTextureRW, neighborTraceSS);
            if (neighborHit.x > 1.0 || neighborHit.y < 0.0)
                continue;

            uint2 neighborSS = SsrGetFullResCoord(neighborTraceSS);
            float3 neighborN;
            float neighborRoughness;
            if (!SsrDecodeMaterial(SSGI_LOAD(_SsrNormalTexture, neighborSS), neighborN, neighborRoughness))
                continue;
            if (neighborRoughness > _SsrRoughnessFadeEnd)
                continue;
            if (dot(neighborN, centerNormalWS) < 0.9)
                continue;

            float neighborDepth = SSGI_LOAD(_SsrDepthTexture, neighborSS);
            if (SsgiIsBackgroundDepth(neighborDepth))
                continue;

            float3 neighborWS = SsrReconstructPositionWS((float2)neighborSS, neighborDepth);
            if (length(neighborWS - centerWS) > positionTolerance)
                continue;

            float sampleOpacity;
            float3 color = SsrSamplePreviousColor(neighborHit, neighborRoughness, sampleOpacity);
            if (sampleOpacity <= 0.0)
                continue;

            outputs += color * sampleOpacity;
            weightSum += sampleOpacity;
            opacitySum += sampleOpacity;
        }
    }

    if (weightSum <= 0.0)
        return false;

    radiance = outputs / weightSum;
    // Four accepted neighbours mean the hole is fully surrounded by valid hits.
    opacity = saturate(opacitySum * (1.0 / 4.0));
    return true;
}

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void ScreenSpaceReflectionsReprojection(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

    uint2 traceCoord = dispatchThreadId.xy;
    if (any(traceCoord >= (uint2)_SsrTraceSize.xy)) return;
    uint2 inputCoord = SsrGetFullResCoord(traceCoord);
    float4 result = float4(0.0, 0.0, 0.0, 0.0);

    float2 hitUv = SSGI_LOAD(_SsrHitPointTextureRW, traceCoord);
    float4 normalSample = SSGI_LOAD(_SsrNormalTexture, inputCoord);
    float3 normalWS;
    float perceptualRoughness;
    bool materialValid = SsrDecodeMaterial(normalSample, normalWS, perceptualRoughness);

#if defined(SSR_APPROX)
    if (materialValid && perceptualRoughness <= _SsrRoughnessFadeEnd)
    {
        float opacity = 0.0;
        float3 color = 0.0;
        if (hitUv.x <= 1.0 && hitUv.y >= 0.0)
            color = SsrSamplePreviousColor(hitUv, perceptualRoughness, opacity);

        if (opacity <= 0.0)
        {
            float centerDepth = SSGI_LOAD(_SsrDepthTexture, inputCoord);
            if (!SsgiIsBackgroundDepth(centerDepth))
            {
                float3 filledRadiance;
                float filledOpacity;
                if (SsrFillMissedPixel(traceCoord, inputCoord, centerDepth, normalWS, perceptualRoughness,
                        filledRadiance, filledOpacity))
                {
                    color = filledRadiance;
                    opacity = filledOpacity;
                }
            }
        }

        if (opacity > 0.0)
            result = float4(color, saturate(opacity));
    }
#else
    float centerOpacity = 0.0;
    if (hitUv.x <= 1.0 && hitUv.y >= 0.0 && materialValid)
    {
        SsrSamplePreviousColor(hitUv, perceptualRoughness, centerOpacity);
        if (centerOpacity > 0.0)
        {
            // HDRP gathers a 3x3 cross around the reflected surface. Every neighbor contributes its
            // own hit radiance weighted by the GGX value over pdf.
            float3 outputs = 0.0;
            float weightSum = 0.0;
            for (int y = -SSR_BLOCK_SAMPLE_RADIUS; y <= SSR_BLOCK_SAMPLE_RADIUS; ++y)
            {
                for (int x = -SSR_BLOCK_SAMPLE_RADIUS; x <= SSR_BLOCK_SAMPLE_RADIUS; ++x)
                {
                    if (abs(x) == abs(y) && abs(x) == 1)
                        continue;

                    int2 neighbor = int2(traceCoord) + int2(x, y);
                    if (neighbor.x < 0 || neighbor.y < 0 ||
                        neighbor.x >= (int)_SsrTraceSize.x || neighbor.y >= (int)_SsrTraceSize.y)
                        continue;

                    uint2 neighborSS = (uint2)neighbor;
                    float2 neighborHit = SSGI_LOAD(_SsrHitPointTextureRW, neighborSS);
                    if (neighborHit.x > 1.0)
                        continue;

                    uint2 neighborGeo = SsrGetFullResCoord(neighborSS);
                    float3 neighborN;
                    float neighborRoughness;
                    if (!SsrDecodeMaterial(SSGI_LOAD(_SsrNormalTexture, neighborGeo), neighborN, neighborRoughness))
                        continue;

                    float neighborDepth = SSGI_LOAD(_SsrDepthTexture, neighborGeo);
                    if (SsgiIsBackgroundDepth(neighborDepth))
                        continue;

                    float3 neighborWS = SsrReconstructPositionWS((float2)neighborGeo, neighborDepth);
                    uint2 hitPixel = (uint2)(saturate(neighborHit) * _SsrScreenSize.xy);
                    hitPixel = min(hitPixel, (uint2)_SsrScreenSize.xy - 1u);
                    float hitDepth = SSGI_LOAD(_SsrDepthTexture, hitPixel);
                    float3 hitWS = SsrReconstructPositionWS((float2)hitPixel, hitDepth);

                    float3 V = normalize(SSL_SSR_CAMERA_POSITION_WS - neighborWS);
                    float3 L = normalize(hitWS - neighborWS);
                    float roughness = clamp(PerceptualRoughnessToRoughness(neighborRoughness), MIN_GGX_ROUGHNESS, MAX_GGX_ROUGHNESS);
                    float weight = SsrGetSampleWeight(dot(neighborN, V), dot(neighborN, L), roughness);
                    if (weight <= 0.0)
                        continue;

                    float sampleOpacity;
                    float3 color = SsrSamplePreviousColor(neighborHit, neighborRoughness, sampleOpacity);
                    if (sampleOpacity > 0.0)
                    {
                        outputs += weight * color;
                        weightSum += weight;
                    }
                }
            }

            if (weightSum > 0.0)
            {
                float3 radiance = outputs / weightSum;
                bool valid = IsFinite(radiance.r) && IsFinite(radiance.g) && IsFinite(radiance.b) && all(radiance >= 0.0);
                if (valid)
                    result = float4(radiance, saturate(centerOpacity));
            }
        }
    }

    if (materialValid && centerOpacity <= 0.0)
    {
        float centerDepth = SSGI_LOAD(_SsrDepthTexture, inputCoord);
        if (!SsgiIsBackgroundDepth(centerDepth))
        {
            float3 filledRadiance;
            float filledOpacity;
            if (SsrFillMissedPixel(traceCoord, inputCoord, centerDepth, normalWS, perceptualRoughness,
                    filledRadiance, filledOpacity))
                result = float4(filledRadiance, saturate(filledOpacity));
        }
    }
#endif

    SSGI_STORE(SSR_APPROX_OUTPUT, traceCoord, result);
}
#endif

//--------------------------------------------------------------------------------------------------
// Parameter debug view (diagnostic, never feeds the material path)
//--------------------------------------------------------------------------------------------------

[numthreads(SSR_TILE_SIZE, SSR_TILE_SIZE, 1)]
void DebugSsrParams(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SSGI_ASSIGN_VIEW_INDEX(dispatchThreadId.z);
    if (dispatchThreadId.x >= (uint)_SsrScreenSize.x || dispatchThreadId.y >= (uint)_SsrScreenSize.y)
        return;

    SSGI_STORE(_SsrOutputTextureRW, dispatchThreadId.xy, float4(0.0, _SsrPbrParams.y, 0.0, _SsrPbrFlags.y));
}
