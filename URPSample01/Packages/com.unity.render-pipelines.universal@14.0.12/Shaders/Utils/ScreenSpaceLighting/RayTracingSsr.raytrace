#pragma max_recursion_depth 2

#include "SsrRayRequest.hlsl"
#include "../../RayTracing/GlxHitLightCounters.hlsl"
#include "../../RayTracing/SsrHitSurface.hlsl"

StructuredBuffer<R1Sample> _R1Queue;
StructuredBuffer<uint> _R1Counts;
RWStructuredBuffer<GlxPublishedHit> _R2Hits;
// C2.7: request-indexed hit surface. A miss or an invalid request publishes version 0, so
// the consumer never needs a separate clear of this 80-byte buffer.
RWStructuredBuffer<SsrHitSurface> _R2Surfaces;
uint _R2K;

// Raygen only: assemble the published-surface record from the reflection payload.
SsrHitSurface SsrBuildHitSurface(in GlxBasicPayload p)
{
    SsrHitSurface s;
    float3 dielectric = float3(0.04, 0.04, 0.04); // URP kDielectricSpec.rgb
    s.gb0 = float4(p.ssrBaseColor, 1.0);
    s.gb1 = float4(SsrDecodeOctNormal(p.ssrNormalOct), p.ssrRoughness);
    s.gb2 = float4(lerp(dielectric, p.ssrBaseColor, p.ssrMetallic), 0.0);
    s.gb3 = float4(p.ssrEmissive, 0.0);
    s.misc = float4(p.hitT, (float)SsrSurfaceTypeLit, (float)SsrHitSurfaceVersion, (float)SsrHitSurfaceSourceRt);
    return s;
}

[shader("raygeneration")]
void TraceSsrRequests()
{
    uint index = DispatchRaysIndex().x;
    if (index >= min(_R1Counts[2], _R2K)) return;
    R1Sample q = _R1Queue[index];
    GlxBasicPayload p = GlxEmptyPayload(GlxReflectionMode);
    SsrHitSurface surface = (SsrHitSurface)0;
    if (all(isfinite(q.position)) && all(isfinite(q.direction)) && dot(q.direction,q.direction) > 0 &&
        q.tMax > q.tMin && q.tMin >= 0)
    {
        RayDesc ray;
        ray.Origin = q.position;
        ray.Direction = normalize(q.direction);
        ray.TMin = q.tMin;
        ray.TMax = q.tMax;
        TraceRay(_GlxScene, RAY_FLAG_NONE, 0xff, 0, 1, 0, ray, p);
        GlxRecordLightCounters(p);
        if ((p.flags & GlxHit) != 0)
            surface = SsrBuildHitSurface(p);
    }
    _R2Hits[q.slot] = GlxPublishPayload(p);
    _R2Surfaces[index] = surface;
}

[shader("miss")]
void SsrMiss(inout GlxBasicPayload p : SV_RayPayload)
{
    p = GlxEmptyPayload(p.mode);
    p.flags = GlxMiss; // Finite TMax: never claim sky radiance, including for a black sky.
}
