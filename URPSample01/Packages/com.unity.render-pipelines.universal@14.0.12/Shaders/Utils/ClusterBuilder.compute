// G1 Stage A/B: builds the cluster bitmaps on the GPU with the CPU jobs' word layout, headers and
// tile/zbin index formulas (HANDOFF §3.4). Only the writer changes; the lighting kernel reads the
// same words through a structured buffer instead of a constant buffer.
//
// Stage A (ClusterItemBounds) computes, per item, the view-space z range and a *conservative*
// screen-space tile AABB. Stage B reproduces ZBinningJob + TileRangeExpansionJob: the zbin scatter
// ORs bit words and takes the per-bin header range with atomics (then a pack pass writes the two
// header words), and the tile expansion owns one (row, tile) thread, so it needs no atomics.
//
// Conservative on purpose: the tile AABB is the item's world bounding box projected through the
// 8 corners, or the full screen when the box crosses the near plane. It can set extra tiles the
// CPU TilingJob would not set (those are then shaded and attenuated to zero), but it never clears
// a bit the CPU sets. Parity is checked as CPU ⊆ GPU for tiles, word-for-word for zbins.
//
// G2 refines the tile bitmap after GBuffer with the FPTL depth backplane: ClusterTilePrune reduces
// the depth buffer to a per-tile linear view-z range and, in the same dispatch, clears the bits of
// items whose actual volume misses that tile's frustum slice. Depth alone would prune almost
// nothing -- the zbin grid already resolves depth in ~1% steps -- but the slice test removes the
// "z overlaps, x/y belongs to another depth" candidates the 2D AABB keeps.

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"

#pragma kernel ClusterItemBounds
#pragma kernel ClusterZBinClear
#pragma kernel ClusterZBinScatter
#pragma kernel ClusterZBinPack
#pragma kernel ClusterTileExpand
#pragma kernel ClusterTileExpandForwardPlus CD_FORWARD_TILE_PLANES
#pragma kernel ClusterTilePrune
#pragma kernel ClusterCellBuild

#define CD_ITEM_LIGHT 0u
#define CD_ITEM_PROBE 1u
#define CD_LIGHTTYPE_SPOT 0
#define CD_PI 3.14159265358979323846

// G3: fixed per-cell capacity. It is a uniform (`_CdClusterCellMax`) so the CPU buffer stride and
// the kernel cannot drift. Lists longer than this (or tiles whose depth slice spans more zbins)
// set the overflow flag and fall back to the bitmap intersection for that cell/tile.
#define CD_CELL_OVERFLOW 0xFFFFFFFFu

struct CdClusterItem
{
    float4 positionRange;    // light: world pos, w = range | probe: bounds center
    float4 directionExtent;  // light: world forward, w = spotAngle | probe: bounds extents
    uint itemType;
    int lightType;
    uint layerMask;
    uint sourceIndex;
};

StructuredBuffer<CdClusterItem> _CdClusterItems;
RWStructuredBuffer<float2> _CdClusterMinMaxZ;
RWStructuredBuffer<int4> _CdClusterTileRanges;  // x/y = row range, z/w = column range; empty: y < x
RWStructuredBuffer<uint> _CdClusterBinMinMax;   // 4 per bin: min/max for header 0 (lights) and 1 (probes)

RWStructuredBuffer<uint> _URPClusterWords;
uint _URPClusterTileOffset; // word address; z-bin region starts at zero

float4 _FPParams0;
float4 _FPParams1;
float4 _FPParams2;

uint _CdClusterItemCount;
uint _CdClusterLightCount;
uint _CdClusterBinCount;
uint2 _CdClusterTileCount;
uint _CdClusterZBinWordCount;
uint _CdClusterTileWordCount;
float2 _CdClusterTileScale;
float4 _CdClusterViewToViewportScaleBias;
float4x4 _CdClusterWorldToView;
float _CdClusterNear;
uint _CdClusterOrthographic;

// G2 depth refinement. The depth texture is the same copy the lighting kernel loads, so the
// per-tile z range is measured on exactly the pixels that will be shaded. Linearizing with
// _ZBufferParams puts the range in the same view-forward-depth space the pixel kernel uses for
// its zbin (dot(viewForward, positionWS - cameraWS)), without another view-projection round trip.
TEXTURE2D(_CdClusterDepthTexture);
float4 _CdClusterZBufferParams;
float4 _CdClusterScreenSize; // width, height, 1/width, 1/height
uint _CdClusterTileWidth;
RWStructuredBuffer<uint> _CdClusterPruneTotals; // [0] kept bits, [1] cleared bits
uint _CdClusterPruneSidePlanes;

// G3 compact lists. One cell per (tile, zbin) inside the tile's own depth slice, so the pixel
// reads one header and a short ascending item list instead of walking bitmap words. Cells and
// tiles that exceed the budget stay on the bitmap path (the kernel checks the same flags).
RWStructuredBuffer<uint> _CdCellHeaders;    // count, or CD_CELL_OVERFLOW
RWStructuredBuffer<uint> _CdCellItems;      // CD_CELL_MAX ascending item indices per cell
RWStructuredBuffer<uint2> _CdTileCellInfo;  // x = first zbin, y = span | 0x80000000 when overflow
RWStructuredBuffer<uint> _CdCellTotals;     // [0] entries, [1] non-empty cells, [2] overflow cells,
                                            // [3] overflow tiles, [4] scanned cells
uint _CdClusterCellMax;

// Signed per-axis sign for corner i (x = bit 0, y = bit 1, z = bit 2). Keep the arithmetic in
// float: the uint form ((i << 1) & 2) - 1 wraps to 0xFFFFFFFF and converts to +4.29e9, which put
// every item's AABB behind the near plane and saturated the tile bitmap.
float3 CdCornerSign(uint i)
{
    return float3((i & 1u) != 0u ? 1.0 : -1.0,
                  (i & 2u) != 0u ? 1.0 : -1.0,
                  (i & 4u) != 0u ? 1.0 : -1.0);
}

float2 CdViewToTile(float3 positionVS)
{
    float2 projected = _CdClusterOrthographic != 0u ? positionVS.xy : positionVS.xy / max(positionVS.z, 1e-6);
    return (projected * _CdClusterViewToViewportScaleBias.xy + _CdClusterViewToViewportScaleBias.zw) * _CdClusterTileScale;
}

// Mirrors LightMinMaxZJob / ReflectionProbeMinMaxZJob. The spot branch is ported verbatim (including
// the cone-height and projected-radius terms) so the zbin bits can line up with the CPU output.
float2 CdItemMinMaxZ(CdClusterItem item, float3 centerWS, float3 centerVS)
{
    if (item.itemType == CD_ITEM_PROBE)
    {
        float3 extents = item.directionExtent.xyz;
        float2 minMax = float2(3.402823466e+38, -3.402823466e+38);
        [unroll] for (uint i = 0u; i < 8u; i++)
        {
            float3 cornerWS = centerWS + extents * CdCornerSign(i);
            float3 cornerVS = mul(_CdClusterWorldToView, float4(cornerWS, 1.0)).xyz;
            cornerVS.z *= -1.0;
            minMax.x = min(minMax.x, cornerVS.z);
            minMax.y = max(minMax.y, cornerVS.z);
        }
        return minMax;
    }

    float range = item.positionRange.w;
    float2 minMax = float2(centerVS.z - range, centerVS.z + range);

    if (item.lightType == CD_LIGHTTYPE_SPOT)
    {
        float angleA = radians(item.directionExtent.w) * 0.5;
        float cosAngleA = cos(angleA);
        float coneHeight = range * cosAngleA;
        float3 endPointWS = centerWS + item.directionExtent.xyz * coneHeight;
        float3 endPointVS = mul(_CdClusterWorldToView, float4(endPointWS, 1.0)).xyz;
        endPointVS.z *= -1.0;
        float angleB = CD_PI * 0.5 - angleA;
        float coneRadius = range * cosAngleA * sin(angleA) / sin(angleB);
        float3 a = endPointVS - centerVS;
        float e = sqrt(1.0 - a.z * a.z / dot(a, a));

        if (-a.z < coneHeight * cosAngleA) minMax.x = min(centerVS.z, endPointVS.z - e * coneRadius);
        if (a.z < coneHeight * cosAngleA) minMax.y = max(centerVS.z, endPointVS.z + e * coneRadius);
    }

    // Only lights clamp to the camera plane; ReflectionProbeMinMaxZJob keeps raw corner depths.
    return max(minMax, float2(0.0, 0.0));
}

int4 CdTileRange(CdClusterItem item, float3 centerWS, float3 boxExtents)
{
    float2 tsMin = float2(3.402823466e+38, 3.402823466e+38);
    float2 tsMax = float2(-3.402823466e+38, -3.402823466e+38);

    [unroll] for (uint i = 0u; i < 8u; i++)
    {
        float3 cornerWS = centerWS + boxExtents * CdCornerSign(i);
        float3 cornerVS = mul(_CdClusterWorldToView, float4(cornerWS, 1.0)).xyz;
        cornerVS.z *= -1.0;

        // A box crossing the near plane has no bounded projection; the safe answer is the screen.
        if (cornerVS.z < _CdClusterNear)
            return int4(0, (int)_CdClusterTileCount.y - 1, 0, (int)_CdClusterTileCount.x - 1);

        float2 tile = CdViewToTile(cornerVS);
        tsMin = min(tsMin, tile);
        tsMax = max(tsMax, tile);
    }

    if (tsMax.x < 0.0 || tsMax.y < 0.0)
        return int4(1, 0, 0, 0);
    if (any(tsMin >= float2(_CdClusterTileCount)))
        return int4(1, 0, 0, 0);

    int2 tileMin = clamp((int2)floor(tsMin), int2(0, 0), (int2)_CdClusterTileCount - 1);
    int2 tileMax = clamp((int2)floor(tsMax), int2(0, 0), (int2)_CdClusterTileCount - 1);
    return int4(tileMin.y, tileMax.y, tileMin.x, tileMax.x);
}

[numthreads(64, 1, 1)]
void ClusterItemBounds(uint3 id : SV_DispatchThreadID)
{
    uint itemIndex = id.x;
    if (itemIndex >= _CdClusterItemCount)
        return;

    CdClusterItem item = _CdClusterItems[itemIndex];
    float3 centerWS = item.positionRange.xyz;
    float3 centerVS = mul(_CdClusterWorldToView, float4(centerWS, 1.0)).xyz;
    centerVS.z *= -1.0;

    float2 minMax = CdItemMinMaxZ(item, centerWS, centerVS);
    _CdClusterMinMaxZ[itemIndex] = minMax;

    // The z range uses the exact sphere the CPU uses; the tile box uses the same sphere for lights
    // (a superset for spots) and the probe's own box.
    float3 boxExtents = item.itemType == CD_ITEM_PROBE
        ? abs(item.directionExtent.xyz)
        : item.positionRange.w * float3(1.0, 1.0, 1.0);
    _CdClusterTileRanges[itemIndex] = CdTileRange(item, centerWS, boxExtents);
}

[numthreads(256, 1, 1)]
void ClusterZBinClear(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < _CdClusterZBinWordCount)
        _URPClusterWords[index] = 0u;
    if (index < _CdClusterTileWordCount)
        _URPClusterWords[_URPClusterTileOffset + index] = 0u;
    if (index < _CdClusterBinCount * 4u)
        _CdClusterBinMinMax[index] = (index & 1u) == 0u ? 0xFFFFu : 0u;
}

[numthreads(64, 1, 1)]
void ClusterZBinScatter(uint3 id : SV_DispatchThreadID)
{
    uint bin = id.x;
    uint item = id.y;
    if (bin >= _CdClusterBinCount || item >= _CdClusterItemCount)
        return;

    float2 minMax = _CdClusterMinMaxZ[item];
    float scale = _FPParams0.x;
    float offset = _FPParams0.y;
    float lo = _CdClusterOrthographic != 0u ? minMax.x : log2(max(minMax.x, 1e-6));
    float hi = _CdClusterOrthographic != 0u ? minMax.y : log2(max(minMax.y, 1e-6));
    float lastBin = (float)(_CdClusterBinCount - 1);

    int minBin = (int)clamp(lo * scale + offset, 0.0, lastBin);
    int maxBin = (int)clamp(hi * scale + offset, 0.0, lastBin);
    if ((int)bin < minBin || (int)bin > maxBin)
        return;

    uint wordsPerTile = (uint)_FPParams1.w;
    uint words = bin * (2u + wordsPerTile);
    InterlockedOr(_URPClusterWords[words + 2u + (item >> 5)], 1u << (item & 31u));

    // Header 0 is the punctual light range, header 1 the reflection probe range; both index the
    // combined item stream, which is what ZBinningJob writes.
    uint slot = bin * 4u + (item < _CdClusterLightCount ? 0u : 2u);
    InterlockedMin(_CdClusterBinMinMax[slot], item);
    InterlockedMax(_CdClusterBinMinMax[slot + 1u], item);
}

[numthreads(64, 1, 1)]
void ClusterZBinPack(uint3 id : SV_DispatchThreadID)
{
    uint bin = id.x;
    if (bin >= _CdClusterBinCount)
        return;

    uint words = bin * (2u + (uint)_FPParams1.w);
    uint slot = bin * 4u;
    _URPClusterWords[words + 0u] = (_CdClusterBinMinMax[slot + 0u] & 0xFFFFu) | ((_CdClusterBinMinMax[slot + 1u] & 0xFFFFu) << 16u);
    _URPClusterWords[words + 1u] = (_CdClusterBinMinMax[slot + 2u] & 0xFFFFu) | ((_CdClusterBinMinMax[slot + 3u] & 0xFFFFu) << 16u);
}

#ifdef CD_FORWARD_TILE_PLANES
bool CdLightOverlapsTile(CdClusterItem item, float2 lo, float2 hi)
{
    if (item.itemType != CD_ITEM_LIGHT)
        return true;

    float radius = item.positionRange.w;
    float3 center = item.positionRange.xyz;
    if (item.lightType == CD_LIGHTTYPE_SPOT)
    {
        float halfCos = cos(radians(item.directionExtent.w) * 0.5);
        if (halfCos > 0.5)
        {
            // The shifted sphere touches both the apex and the outer rim of the spherical sector.
            radius *= 0.5 / halfCos;
            center += normalize(item.directionExtent.xyz) * radius;
        }
    }
    float3 view = mul(_CdClusterWorldToView, float4(center, 1.0)).xyz;
    float z = _CdClusterOrthographic != 0u ? 1.0 : -view.z;
    radius = radius * 1.0001 + 1e-4;
    float2 padLo = radius, padHi = radius;
    if (_CdClusterOrthographic == 0u)
    {
        padLo *= sqrt(1.0 + lo * lo);
        padHi *= sqrt(1.0 + hi * hi);
    }
    return all(view.xy - lo * z >= -padLo) && all(hi * z - view.xy >= -padHi);
}
#define ClusterTileExpand ClusterTileExpandForwardPlus
#endif

[numthreads(8, 8, 1)]
void ClusterTileExpand(uint3 id : SV_DispatchThreadID)
{
    uint tileX = id.x;
    uint tileY = id.y;
    if (tileX >= _CdClusterTileCount.x || tileY >= _CdClusterTileCount.y)
        return;

    uint wordsPerTile = (uint)_FPParams1.w;
    uint wordBase = (tileY * _CdClusterTileCount.x + tileX) * wordsPerTile;
#ifdef CD_FORWARD_TILE_PLANES
    float2 a = (float2(id.xy) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;
    float2 b = (float2(id.xy + 1u) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;
#endif

    [loop] for (uint item = 0u; item < _CdClusterItemCount; item++)
    {
        int4 range = _CdClusterTileRanges[item];
        if ((int)tileY >= range.x && (int)tileY <= range.y &&
            (int)tileX >= range.z && (int)tileX <= range.w)
        {
#ifdef CD_FORWARD_TILE_PLANES
            if (!CdLightOverlapsTile(_CdClusterItems[item], min(a, b), max(a, b)))
                continue;
#endif
            _URPClusterWords[_URPClusterTileOffset + wordBase + (item >> 5)] |= 1u << (item & 31u);
        }
    }
}

// ----------------------------------------------------------------------------
// G2: depth backplane + frustum-slice prune
// ----------------------------------------------------------------------------

// Conservative sphere-vs-frustum-slice test. tileLo/tileHi are the tile's lower/upper x/z
// (perspective) or view x/y (orthographic) bounds. A sphere touching the camera plane keeps its
// AABB: its projection is unbounded.
bool CdSphereIntersectsTileSlice(float3 centerVS, float radius, float2 tileLo, float2 tileHi)
{
    if (_CdClusterOrthographic == 0u && centerVS.z - radius <= 1e-6)
        return true;

    if (_CdClusterOrthographic != 0u)
    {
        if (centerVS.x + radius < tileLo.x || centerVS.x - radius > tileHi.x)
            return false;
        if (centerVS.y + radius < tileLo.y || centerVS.y - radius > tileHi.y)
            return false;
        return true;
    }

    float z = max(centerVS.z, 1e-6);
    float2 lo = float2(centerVS.x - tileLo.x * z, centerVS.y - tileLo.y * z) * rsqrt(1.0 + tileLo * tileLo);
    float2 hi = float2(tileHi.x * z - centerVS.x, tileHi.y * z - centerVS.y) * rsqrt(1.0 + tileHi * tileHi);
    return lo.x + radius >= 0.0 && lo.y + radius >= 0.0 &&
           hi.x + radius >= 0.0 && hi.y + radius >= 0.0;
}

// One 8x8 group per tile: threads cooperatively measure the tile's depth slice from the same
// depth copy the lighting kernel reads, then thread 0 clears the bits whose volume misses it.
// Range and prune share the tile/params in one dispatch, so they cannot disagree about the grid.
groupshared uint CdTileMinZ;
groupshared uint CdTileMaxZ;
groupshared uint CdTileValid;

[numthreads(8, 8, 1)]
void ClusterTilePrune(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint2 tile = groupId.xy;
    if (tile.x >= _CdClusterTileCount.x || tile.y >= _CdClusterTileCount.y)
        return;

    if (threadId.x == 0u && threadId.y == 0u)
    {
        CdTileMinZ = 0xFFFFFFFFu;
        CdTileMaxZ = 0u;
        CdTileValid = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    uint tileIndex = tile.y * _CdClusterTileCount.x + tile.x;
    uint wordsPerTile = (uint)_FPParams1.w;
    uint wordBase = tileIndex * wordsPerTile;

    uint2 screen = max((uint2)_CdClusterScreenSize.xy, uint2(1u, 1u));
    uint2 tileBase = tile * _CdClusterTileWidth;
    float zMin = 3.402823466e+38;
    float zMax = -3.402823466e+38;
    uint valid = 0u;

    [loop] for (uint y = threadId.y; y < _CdClusterTileWidth; y += 8u)
    {
        [loop] for (uint x = threadId.x; x < _CdClusterTileWidth; x += 8u)
        {
            uint2 pixel = min(tileBase + uint2(x, y), screen - 1u);
            float rawDepth = LOAD_TEXTURE2D(_CdClusterDepthTexture, pixel).x;
            if (rawDepth == UNITY_RAW_FAR_CLIP_VALUE)
                continue;

            float z = 1.0 / (_CdClusterZBufferParams.z * rawDepth + _CdClusterZBufferParams.w);
            zMin = min(zMin, z);
            zMax = max(zMax, z);
            valid++;
        }
    }

    // Empty threads must not contribute: -FLT_MAX asuint is 0xFF7FFFFF, which outranks every
    // positive float in the uint-ordered InterlockedMax and would collapse the tile's far bound.
    if (valid != 0u)
    {
        InterlockedMin(CdTileMinZ, asuint(zMin));
        InterlockedMax(CdTileMaxZ, asuint(zMax));
    }
    InterlockedAdd(CdTileValid, valid);
    GroupMemoryBarrierWithGroupSync();

    if (threadId.x != 0u || threadId.y != 0u)
        return;

    float2 depthRange = CdTileValid == 0u
        ? float2(3.402823466e+38, -3.402823466e+38)
        : float2(asfloat(CdTileMinZ), asfloat(CdTileMaxZ));
    bool hasGeometry = CdTileValid != 0u;

    float2 tileLo = (float2(tile) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;
    float2 tileHi = (float2(tile + 1u) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;

    // Never clear an item a pixel in this tile could still reach.
    float depthPad = 1e-3 * max(1.0, abs(depthRange.y));

    uint kept = 0u;
    uint cleared = 0u;

    [loop] for (uint item = 0u; item < _CdClusterItemCount; item++)
    {
        uint word = item >> 5;
        uint mask = 1u << (item & 31u);
        uint current = _URPClusterWords[_URPClusterTileOffset + wordBase + word];
        if ((current & mask) == 0u)
            continue;

        bool keep = hasGeometry;
        if (keep)
        {
            float2 itemDepth = _CdClusterMinMaxZ[item];
            keep = itemDepth.y >= depthRange.x - depthPad && itemDepth.x <= depthRange.y + depthPad;
        }

        if (keep && _CdClusterPruneSidePlanes != 0u)
        {
            CdClusterItem itemData = _CdClusterItems[item];
            float3 centerVS = mul(_CdClusterWorldToView, float4(itemData.positionRange.xyz, 1.0)).xyz;
            centerVS.z *= -1.0;
            float radius = itemData.itemType == CD_ITEM_PROBE
                ? length(itemData.directionExtent.xyz)
                : itemData.positionRange.w;
            keep = CdSphereIntersectsTileSlice(centerVS, radius * 1.0001 + 1e-4, tileLo, tileHi);
        }

        if (keep)
        {
            kept++;
        }
        else
        {
            _URPClusterWords[_URPClusterTileOffset + wordBase + word] = current & ~mask;
            cleared++;
        }
    }

    InterlockedAdd(_CdClusterPruneTotals[0], kept);
    InterlockedAdd(_CdClusterPruneTotals[1], cleared);
}

// ----------------------------------------------------------------------------
// G3: per-(tile, zbin) compact lists
// ----------------------------------------------------------------------------

groupshared uint CdCellMinZ;
groupshared uint CdCellMaxZ;
groupshared uint CdCellValid;
groupshared int CdCellBinLo;
groupshared uint CdCellSpan;

// Same bin expression as the lighting kernel's CdClusterInit (perspective: log2 of the linear view
// depth; orthographic: linear). Floor keeps the mapping monotone in z like the truncating cast.
int CdCellDepthBin(float z)
{
    float term = _CdClusterOrthographic != 0u ? z : log2(max(z, 1e-6));
    return (int)floor(term * _FPParams0.x + _FPParams0.y);
}

// One 8x8 group per tile. The group measures the tile's depth slice from the same depth copy the
// lighting kernel reads, maps it to a zbin range (padded one bin each side so the pixel's own
// truncation can never fall outside), and fills one cell per zbin with the ascending item indices
// present in both bitmaps. Nothing here modifies the shared bitmap words, so the bitmap path stays the
// reference: cells the budget cannot hold keep the overflow flag and the pixel uses the bitmap.
[numthreads(8, 8, 1)]
void ClusterCellBuild(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint2 tile = groupId.xy;
    if (tile.x >= _CdClusterTileCount.x || tile.y >= _CdClusterTileCount.y)
        return;

    uint linearThread = threadId.y * 8u + threadId.x;
    uint tileIndex = tile.y * _CdClusterTileCount.x + tile.x;
    uint tileCellBase = tileIndex * _CdClusterCellMax;

    if (linearThread == 0u)
    {
        CdCellMinZ = 0xFFFFFFFFu;
        CdCellMaxZ = 0u;
        CdCellValid = 0u;
        CdCellBinLo = 0;
        CdCellSpan = 0u;
    }

    // Clear this tile's headers while the group starts the depth scan; stale item slots are harmless
    // because a reader stops at the count.
    for (uint slot = linearThread; slot < _CdClusterCellMax; slot += 64u)
        _CdCellHeaders[tileCellBase + slot] = 0u;

    uint2 screen = max((uint2)_CdClusterScreenSize.xy, uint2(1u, 1u));
    uint2 tileBase = tile * _CdClusterTileWidth;
    float zMin = 3.402823466e+38;
    float zMax = -3.402823466e+38;
    uint valid = 0u;

    [loop] for (uint y = threadId.y; y < _CdClusterTileWidth; y += 8u)
    {
        [loop] for (uint x = threadId.x; x < _CdClusterTileWidth; x += 8u)
        {
            uint2 pixel = min(tileBase + uint2(x, y), screen - 1u);
            float rawDepth = LOAD_TEXTURE2D(_CdClusterDepthTexture, pixel).x;
            if (rawDepth == UNITY_RAW_FAR_CLIP_VALUE)
                continue;

            float z = 1.0 / (_CdClusterZBufferParams.z * rawDepth + _CdClusterZBufferParams.w);
            zMin = min(zMin, z);
            zMax = max(zMax, z);
            valid++;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    if (valid != 0u)
    {
        InterlockedMin(CdCellMinZ, asuint(zMin));
        InterlockedMax(CdCellMaxZ, asuint(zMax));
    }
    InterlockedAdd(CdCellValid, valid);
    GroupMemoryBarrierWithGroupSync();

    if (linearThread == 0u)
    {
        if (CdCellValid == 0u)
        {
            // Empty tile: the lighting kernel returns on the far-depth test before touching cells.
            // No early return here: every thread must reach the group barrier below.
            _CdTileCellInfo[tileIndex] = uint2(0u, 0u);
            CdCellSpan = 0u;
        }
        else
        {
            int last = (int)_CdClusterBinCount - 1;
            int binLo = clamp(CdCellDepthBin(asfloat(CdCellMinZ)) - 1, 0, last);
            int binHi = clamp(CdCellDepthBin(asfloat(CdCellMaxZ)) + 1, 0, last);
            uint span = (uint)(binHi - binLo + 1);
            InterlockedAdd(_CdCellTotals[4], span);

            if (span > _CdClusterCellMax)
            {
                _CdTileCellInfo[tileIndex] = uint2((uint)binLo, 0x80000000u);
                InterlockedAdd(_CdCellTotals[3], 1u);
                CdCellSpan = 0u;
            }
            else
            {
                CdCellBinLo = binLo;
                CdCellSpan = span;
                _CdTileCellInfo[tileIndex] = uint2((uint)binLo, span);
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    uint span = CdCellSpan;
    if (linearThread >= span)
        return;

    uint bin = (uint)CdCellBinLo + linearThread;
    uint wordsPerTile = (uint)_FPParams1.w;
    uint stride = 2u + wordsPerTile;
    uint tileWordBase = tileIndex * wordsPerTile;
    uint zBinWordBase = bin * stride + 2u;
    uint cell = tileCellBase + linearThread;
    uint itemBase = cell * _CdClusterCellMax;

    float2 tileLo = (float2(tile) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;
    float2 tileHi = (float2(tile + 1u) / _CdClusterTileScale - _CdClusterViewToViewportScaleBias.zw) / _CdClusterViewToViewportScaleBias.xy;

    uint count = 0u;
    bool overflow = false;

    [loop] for (uint word = 0u; word < wordsPerTile && !overflow; word++)
    {
        uint bits = _URPClusterWords[_URPClusterTileOffset + tileWordBase + word] & _URPClusterWords[zBinWordBase + word];
        [loop] while (bits != 0u)
        {
            uint bit = firstbitlow(bits);
            bits &= bits - 1u;
            uint item = word * 32u + bit;
            if (item >= _CdClusterItemCount)
                continue;

            // The zbin already resolves depth; the slice test only drops candidates whose 2D AABB
            // reaches this tile while the volume itself lies in a neighbouring x/y slice.
            if (_CdClusterPruneSidePlanes != 0u)
            {
                CdClusterItem itemData = _CdClusterItems[item];
                float3 centerVS = mul(_CdClusterWorldToView, float4(itemData.positionRange.xyz, 1.0)).xyz;
                centerVS.z *= -1.0;
                float radius = itemData.itemType == CD_ITEM_PROBE
                    ? length(itemData.directionExtent.xyz)
                    : itemData.positionRange.w;
                if (!CdSphereIntersectsTileSlice(centerVS, radius * 1.0001 + 1e-4, tileLo, tileHi))
                    continue;
            }

            if (count >= _CdClusterCellMax)
            {
                overflow = true;
                break;
            }

            _CdCellItems[itemBase + count] = item;
            count++;
        }
    }

    if (overflow)
    {
        _CdCellHeaders[cell] = CD_CELL_OVERFLOW;
        InterlockedAdd(_CdCellTotals[2], 1u);
    }
    else
    {
        _CdCellHeaders[cell] = count;
        if (count != 0u)
            InterlockedAdd(_CdCellTotals[1], 1u);
    }
    InterlockedAdd(_CdCellTotals[0], count);
}
