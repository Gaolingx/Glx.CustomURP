// Clustered Deferred (URP BRDF) lighting kernel.
//
// Dispatch is pixel-parallel: ceil(viewport / 16) groups of 16x16 threads, one pixel per thread.
// The tile id is derived per pixel from _FPParams1.xy, so the kernel does not care whether the CPU
// picked an 8/16/32/64-wide tile. Each thread composes direct + baked lighting and fog into the final UAV.
//
// Shadows are the T4 shadow subset: main light (cascade or screen space) and additional-light
// atlas shadows, disabled per pixel by the GBuffer receive-shadows-off flag. Cookies, light
// layers, mixed lighting/shadowmask and screen-space AO are the rest of T4.
#pragma kernel ClusteredDeferred

#pragma multi_compile _ _GBUFFER_NORMALS_OCT
#pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
#pragma multi_compile _ _ADDITIONAL_LIGHT_SHADOWS
#pragma multi_compile _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH
#pragma multi_compile _ _LIGHT_COOKIES
#pragma multi_compile _ _LIGHT_LAYERS
#pragma multi_compile _ _SCREEN_SPACE_OCCLUSION
#pragma multi_compile _ _DEFERRED_MIXED_LIGHTING
// Cameras without the feature never bind a contact texture. The off kernel must not declare it.
#pragma multi_compile _ _CONTACT_SHADOWS_DEFERRED

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/ClusteredDeferred.hlsl"
#if defined(_CONTACT_SHADOWS_DEFERRED)
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/ContactShadows.hlsl"
#endif
// P3 indirect-specular composite. ClusteredDeferredPass binds it on every dispatch: the texture the
// 225 pass published this frame, or a 1x1 black when no receiver was routed. The unconditional
// binding is what keeps the declared texture from being unbound (which would drop the dispatch),
// so this needs no keyword variant.
TEXTURE2D(_GlxSsrSpecular);

RWTexture2D<float4> _CdLightingTextureRW;

half CdAdditionalShadowAtPixel(uint2 pixel, uint lightIndex, float3 positionWS, half3 direction, half4 shadowMask)
{
    half shadow = CdAdditionalLightShadow(lightIndex, positionWS, direction, shadowMask, _AdditionalLightsOcclusionProbes[lightIndex]);
#if defined(URP_CONTACT_SHADOWS_SUPPORTED) && defined(CD_ADDITIONAL_LIGHT_CALCULATE_SHADOWS)
    // A shadow-casting neighbour can enable the variant; check this light's atlas slice and strength.
    half4 params = CdGetAdditionalLightShadowParams(lightIndex);
    if (params.w >= 0.0h && params.x > 0.0h)
        shadow = min(shadow, GetContactShadowAtPixel(pixel, GetAdditionalLightContactShadowMask(lightIndex)));
#endif
    return shadow;
}

float4 CdDeferredLighting(uint2 pixel, uint materialType, float rawDepth)
{
    float2 uv = (pixel + 0.5) * _ScreenSize.zw;
    float3 positionWS = ComputeWorldSpacePosition(uv, rawDepth, unity_MatrixInvVP);

    half4 gbuffer0 = LOAD_TEXTURE2D(_GBuffer0, pixel);
    half4 gbuffer1 = LOAD_TEXTURE2D(_GBuffer1, pixel);
    half4 gbuffer2 = LOAD_TEXTURE2D(_GBuffer2, pixel);

    CdInputData inputData = CdInputDataFromGbufferAndWorldPosition(gbuffer2, positionWS, uv);

    uint materialFlags = CdUnpackMaterialFlags(gbuffer0.a);
    bool receiveShadowsOff = (materialFlags & CD_FLAG_RECEIVE_SHADOWS_OFF) != 0;
    // Skip subtractive mixed lights on geometry that already includes their baked lighting.
    bool subtractiveMaterial = (materialFlags & CD_FLAG_SUBTRACTIVE_MIXED_LIGHTING) != 0;

    // GBuffer shadowmask/probes-occlusion slot, written when the deferred path runs mixed lighting.
    half4 shadowMask = half4(1.0, 1.0, 1.0, 1.0);
#if defined(_DEFERRED_MIXED_LIGHTING)
    shadowMask = LOAD_TEXTURE2D(_CdShadowMaskTexture, pixel);
#endif

#if defined(_LIGHT_LAYERS)
    uint meshRenderingLayers = CdDecodeMeshRenderingLayer(LOAD_TEXTURE2D(_CdLightLayersTexture, pixel).r);
#endif

    half3 color = 0.0.xxx;

    CdLight mainLight = CdMainLight(positionWS);
    bool mainLightCulled = mainLight.subtractiveMixed && subtractiveMaterial;
#if defined(_LIGHT_LAYERS)
    mainLightCulled = mainLightCulled || !IsMatchingLightLayer(mainLight.layerMask, meshRenderingLayers);
#endif
    if (!mainLightCulled)
    {
        if (!receiveShadowsOff)
        {
            float4 shadowCoord = CdTransformWorldToShadowCoord(positionWS, uv);
            mainLight.shadowAttenuation = CdMainLightShadow(shadowCoord, positionWS, shadowMask, _MainLightOcclusionProbes);
#ifdef URP_CONTACT_SHADOWS_SUPPORTED
            mainLight.shadowAttenuation = min(mainLight.shadowAttenuation, GetContactShadowAtPixel(pixel, _MainLightContactShadowMask));
#endif
        }
        color += CdShade(materialType, gbuffer0, gbuffer1, gbuffer2, mainLight, inputData);
    }

    // Additional directional lights are not part of the cluster list; Forward+ loops them first
    // (Lighting.hlsl:463-483) and the cluster indices are offset by their count.
    [loop] for (uint directionalIndex = 0u;
        directionalIndex < min(URP_FP_DIRECTIONAL_LIGHTS_COUNT, (uint)CD_MAX_VISIBLE_LIGHTS);
        directionalIndex++)
    {
        CdLight light = CdGetAdditionalLight(directionalIndex, positionWS);
        bool culled = light.subtractiveMixed && subtractiveMaterial;
#if defined(_LIGHT_LAYERS)
        culled = culled || !IsMatchingLightLayer(light.layerMask, meshRenderingLayers);
#endif
        if (culled)
            continue;

        if (!receiveShadowsOff)
            light.shadowAttenuation = CdAdditionalShadowAtPixel(pixel, directionalIndex, positionWS, light.direction, shadowMask);
        color += CdShade(materialType, gbuffer0, gbuffer1, gbuffer2, light, inputData);
    }

    CdClusterIterator iterator = CdClusterInit(uv, positionWS);
    uint lightIndex;
    [loop] while (CdClusterNext(iterator, lightIndex))
    {
        lightIndex += URP_FP_DIRECTIONAL_LIGHTS_COUNT;
        if (lightIndex >= (uint)CD_MAX_VISIBLE_LIGHTS)
            continue;

        CdLight light = CdGetAdditionalLight(lightIndex, positionWS);
        bool culled = light.subtractiveMixed && subtractiveMaterial;
#if defined(_LIGHT_LAYERS)
        culled = culled || !IsMatchingLightLayer(light.layerMask, meshRenderingLayers);
#endif
        if (culled)
            continue;

        if (!receiveShadowsOff)
            light.shadowAttenuation = CdAdditionalShadowAtPixel(pixel, lightIndex, positionWS, light.direction, shadowMask);
        color += CdShade(materialType, gbuffer0, gbuffer1, gbuffer2, light, inputData);
    }

    // Direct AO is a per-pixel factor; apply it once to the sum rather than to each light.
    color *= CdDirectAmbientOcclusion(uv);

    return float4(color, CdIndirectAmbientOcclusionCancel(uv, gbuffer1.a));
}

[numthreads(16, 16, 1)]
void ClusteredDeferred(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixel = dispatchThreadId.xy;
    if (any(pixel >= (uint2)_ScreenSize.xy))
        return;

    float4 result = LOAD_TEXTURE2D(_CdBakedColor, pixel);
    float rawDepth = LOAD_TEXTURE2D(_CameraDepthTexture, pixel).x;
    if (rawDepth != UNITY_RAW_FAR_CLIP_VALUE)
    {
        // StencilUsage.MaterialMask occupies bits 5 and 6; ignore user and reserved bits.
        uint materialType = (GetStencilValue(LOAD_TEXTURE2D(_CdStencilTexture, pixel)) >> 5) & 3u;
        if (materialType == 1u || materialType == 2u)
        {
            // The deferred GBuffer no longer carries indirect specular; the plugin composites it
            // separately. Add it to the baked colour before the SSAO-cancel multiply so it follows
            // the same occlusion handling as the baked term.
            float3 baked = result.rgb;
            baked += LOAD_TEXTURE2D(_GlxSsrSpecular, pixel).rgb;
            // Reproduce the R16G16B16A16_SFloat store/load before Blend One SrcAlpha.
            // A half cast alone is a no-op on desktop backends where half maps to float.
            float4 light = f16tof32(f32tof16(CdDeferredLighting(pixel, materialType, rawDepth)));
            result.rgb = light.rgb + baked * light.a;
        }
        result.rgb = CdApplyFog(result.rgb, rawDepth);
    }
    _CdLightingTextureRW[pixel] = result;
}
