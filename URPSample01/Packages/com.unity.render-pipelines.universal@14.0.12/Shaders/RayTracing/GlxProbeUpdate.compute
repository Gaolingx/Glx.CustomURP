// G2 probe producer: GPU ray preparation from the published probe state, irradiance and
// distance-moment convolution with hysteresis, relocation/classification from the 32 fixed
// maintenance rays, and a readback kernel used by the validation player.
//
// Kept free of raytracing headers: a compute shader cannot declare the acceleration
// structure, so the 24-byte published result and the mode/flag words are mirrored here.
// Keep in sync with Shaders/RayTracing/GlxPublishedHit.hlsl.

#pragma kernel ProbePrepare
#pragma kernel ProbeCopyState
#pragma kernel ProbeIrradiance
#pragma kernel ProbeDistance
#pragma kernel ProbeMaintain
#pragma kernel ProbePublishMask
#pragma kernel ProbeReadbackIrr
#pragma kernel ProbeReadbackDist
#pragma kernel ProbeReadbackMeta

#include "GlxProbeRanges.hlsl"

#define GLX_HIT 2u
#define GLX_MISS 1u
#define GLX_SKY 8u
#define GLX_PROBE_MODE 4u
#define GLX_PROBE_GEO_MODE 5u
#define PI 3.14159265358979323846
#define IRR_INTERIOR 6
#define IRR_TILE 8
#define DIST_INTERIOR 14
#define DIST_TILE 16
#define PROBES_PER_ROW 8

struct GlxProbePayload { float3 radiance; float hitT; uint flags, mode; };
struct GlxProbeRay { float4 originTMin; float4 directionTMax; uint4 meta; };

uint _GlxProbeBudget, _GlxProbeRaysPerProbe, _GlxProbeFrame;
uint _GlxProbeCountX, _GlxProbeCountY, _GlxProbeCountZ;
uint _GlxProbeCount;
float3 _GlxProbeOrigin;
float _GlxProbeSpacing, _GlxProbeTMin, _GlxProbeTMax;
float _GlxProbePreviousWeight, _GlxProbeRelocationLimit, _GlxProbeMinFront, _GlxProbeInsideBackface, _GlxProbeMomentCap;
uint _GlxProbeRelocate, _GlxProbeClassify;

RWStructuredBuffer<GlxProbeRay> _GlxProbeRays;
StructuredBuffer<GlxProbePayload> _GlxProbeResults;
StructuredBuffer<float4> _GlxProbeData;
RWStructuredBuffer<float4> _GlxProbeDataNext;
StructuredBuffer<uint> _GlxProbePublished;
RWStructuredBuffer<uint> _GlxProbeUpdated;
RWStructuredBuffer<uint> _GlxProbePublishedNext;
StructuredBuffer<uint> _GlxProbeBatch;
RWStructuredBuffer<uint> _GlxProbeCounters;

RWTexture2D<float4> _GlxProbeIrrWrite;
Texture2D<float4> _GlxProbeIrrPrev;
RWTexture2D<float2> _GlxProbeDistWrite;
Texture2D<float2> _GlxProbeDistPrev;

RWStructuredBuffer<float4> _GlxProbeReadbackIrr;
RWStructuredBuffer<float4> _GlxProbeReadbackDist;
RWStructuredBuffer<uint2> _GlxProbeReadbackMeta;
uint _GlxProbeReadbackProbe;

float3 GlxFibonacci(uint i, uint n)
{
    float y = 1.0 - 2.0 * ((float)i + 0.5) / (float)n;
    float r = sqrt(saturate(1.0 - y * y));
    float phi = (float)i * 2.39996322972865332;
    return float3(cos(phi) * r, y, sin(phi) * r);
}

float3 GlxRotateY(float3 d, float angle)
{
    float c = cos(angle), s = sin(angle);
    return float3(c * d.x - s * d.z, d.y, s * d.x + c * d.z);
}

float GlxLuminance(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }
float GlxMax3(float3 v) { return max(v.x, max(v.y, v.z)); }

// G1 ProbeHalfAtlas.Normal: the octahedral texel centre direction for an interior texel.
float3 GlxOctNormal(uint n, int x, int y)
{
    float u = (2.0 * x + 1.0) / (float)n - 1.0;
    float v = (2.0 * y + 1.0) / (float)n - 1.0;
    float z = 1.0 - abs(u) - abs(v);
    return normalize(float3(u - (u >= 0 ? 1.0 : -1.0) * max(0.0, -z),
                            v - (v >= 0 ? 1.0 : -1.0) * max(0.0, -z), z));
}

// Octahedral seam borders, RTXGI order: (srcX, srcY, dstX, dstY) in tile coordinates with
// one texel of border on every side. A border texel takes the interior texel the seam folds
// onto; mirroring the tile edge does not reproduce that mapping away from the corners.
#define IRR_BORDER_TEXELS (IRR_INTERIOR * 4 + 4)
static const uint4 IRR_BORDER_OFFSETS[IRR_BORDER_TEXELS] =
{
    uint4(6, 6, 0, 0),
    uint4(6, 1, 1, 0), uint4(5, 1, 2, 0), uint4(4, 1, 3, 0), uint4(3, 1, 4, 0), uint4(2, 1, 5, 0), uint4(1, 1, 6, 0),
    uint4(1, 6, 7, 0),
    uint4(1, 6, 0, 1), uint4(1, 5, 0, 2), uint4(1, 4, 0, 3), uint4(1, 3, 0, 4), uint4(1, 2, 0, 5), uint4(1, 1, 0, 6),
    uint4(6, 1, 0, 7),
    uint4(6, 6, 7, 1), uint4(6, 5, 7, 2), uint4(6, 4, 7, 3), uint4(6, 3, 7, 4), uint4(6, 2, 7, 5), uint4(6, 1, 7, 6),
    uint4(1, 1, 7, 7),
    uint4(6, 6, 1, 7), uint4(5, 6, 2, 7), uint4(4, 6, 3, 7), uint4(3, 6, 4, 7), uint4(2, 6, 5, 7), uint4(1, 6, 6, 7)
};

#define DIST_BORDER_TEXELS (DIST_INTERIOR * 4 + 4)
static const uint4 DIST_BORDER_OFFSETS[DIST_BORDER_TEXELS] =
{
    uint4(14, 14, 0, 0),
    uint4(14, 1, 1, 0), uint4(13, 1, 2, 0), uint4(12, 1, 3, 0), uint4(11, 1, 4, 0), uint4(10, 1, 5, 0), uint4(9, 1, 6, 0), uint4(8, 1, 7, 0),
    uint4(7, 1, 8, 0), uint4(6, 1, 9, 0), uint4(5, 1, 10, 0), uint4(4, 1, 11, 0), uint4(3, 1, 12, 0), uint4(2, 1, 13, 0), uint4(1, 1, 14, 0),
    uint4(1, 14, 15, 0),
    uint4(1, 14, 0, 1), uint4(1, 13, 0, 2), uint4(1, 12, 0, 3), uint4(1, 11, 0, 4), uint4(1, 10, 0, 5), uint4(1, 9, 0, 6), uint4(1, 8, 0, 7),
    uint4(1, 7, 0, 8), uint4(1, 6, 0, 9), uint4(1, 5, 0, 10), uint4(1, 4, 0, 11), uint4(1, 3, 0, 12), uint4(1, 2, 0, 13), uint4(1, 1, 0, 14),
    uint4(14, 1, 0, 15),
    uint4(14, 14, 15, 1), uint4(14, 13, 15, 2), uint4(14, 12, 15, 3), uint4(14, 11, 15, 4), uint4(14, 10, 15, 5), uint4(14, 9, 15, 6), uint4(14, 8, 15, 7),
    uint4(14, 7, 15, 8), uint4(14, 6, 15, 9), uint4(14, 5, 15, 10), uint4(14, 4, 15, 11), uint4(14, 3, 15, 12), uint4(14, 2, 15, 13), uint4(14, 1, 15, 14),
    uint4(1, 1, 15, 15),
    uint4(14, 14, 1, 15), uint4(13, 14, 2, 15), uint4(12, 14, 3, 15), uint4(11, 14, 4, 15), uint4(10, 14, 5, 15), uint4(9, 14, 6, 15), uint4(8, 14, 7, 15),
    uint4(7, 14, 8, 15), uint4(6, 14, 9, 15), uint4(5, 14, 10, 15), uint4(4, 14, 11, 15), uint4(3, 14, 12, 15), uint4(2, 14, 13, 15), uint4(1, 14, 14, 15)
};

float3 GlxGridPosition(uint probe)
{
    uint xy = _GlxProbeCountX * _GlxProbeCountY;
    return _GlxProbeOrigin + float3(probe % _GlxProbeCountX,
        (probe / _GlxProbeCountX) % _GlxProbeCountY, probe / xy) * _GlxProbeSpacing;
}

// The next generation starts as a copy of the published one: only scheduled tiles change,
// and unscheduled probes keep their offset/state and publication bit.
[numthreads(64, 1, 1)]
void ProbeCopyState(uint3 id : SV_DispatchThreadID)
{
    uint probe = id.x;
    if (probe >= _GlxProbeCount) return;
    _GlxProbeDataNext[probe] = _GlxProbeData[probe];
    _GlxProbePublishedNext[probe] = _GlxProbePublished[probe];
}

[numthreads(64, 1, 1)]
void ProbePrepare(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint index = group.x * 64u + lane;
    if (index >= _GlxProbeBudget * _GlxProbeRaysPerProbe) return;
    uint slot = index / _GlxProbeRaysPerProbe;
    uint rayIndex = index % _GlxProbeRaysPerProbe;
    uint probe = _GlxProbeBatch[slot];
    float4 data = _GlxProbeData[probe];
    bool active = data.w > 0.5;
    bool maintenance = rayIndex < 32u;
    bool valid = maintenance || active;

    float3 origin = GlxGridPosition(probe) + data.xyz;
    float3 direction = maintenance
        ? GlxFibonacci(rayIndex, 32u)
        : GlxRotateY(GlxFibonacci(rayIndex - 32u, _GlxProbeRaysPerProbe - 32u), _GlxProbeFrame * 0.61803398874989485);

    GlxProbeRay ray;
    ray.originTMin = float4(origin, _GlxProbeTMin);
    // Radiance rays run to infinity: a miss then proves the ray escaped every registered
    // surface, which is the only miss the sky input accepts. Maintenance rays stay near-field
    // so a truncated ray never classifies as geometry or as sky.
    ray.directionTMax = float4(direction, maintenance ? _GlxProbeTMax : GLX_PROBE_SKY_TMAX);
    ray.meta = uint4(maintenance ? GLX_PROBE_GEO_MODE : GLX_PROBE_MODE, slot, rayIndex, valid ? 1u : 0u);
    _GlxProbeRays[index] = ray;
    if (rayIndex == 0) InterlockedAdd(_GlxProbeCounters[active ? 5u : 6u], 1);
}

// Cosine-weighted convolution, G1 convention: E = pi * sum(w L) / sum(w).
// Only rays 32..R-1 contribute; the fixed maintenance prefix is excluded. A sky sample is a
// radiance sample like a hit (the miss shader already decided the ray escaped all geometry).
[numthreads(IRR_TILE, IRR_TILE, 1)]
void ProbeIrradiance(uint3 id : SV_DispatchThreadID)
{
    // The dispatch is exactly (1, 1, budget) and one thread group owns one probe, so no
    // group-uniform early return may precede the barrier (FXC rejects it as varying flow).
    uint slot = id.z;
    uint probe = _GlxProbeBatch[slot];
    bool active = _GlxProbeData[probe].w > 0.5; // inactive: keep the previous tile
    bool interior = id.x >= 1u && id.x <= IRR_INTERIOR && id.y >= 1u && id.y <= IRR_INTERIOR;
    uint2 tileBase = uint2((probe % PROBES_PER_ROW) * IRR_TILE, (probe / PROBES_PER_ROW) * IRR_TILE);

    if (active && interior)
    {
        float3 normal = GlxOctNormal(IRR_INTERIOR, (int)id.x - 1, (int)id.y - 1);
        float3 sum = 0;
        float denominator = 0;
        uint base = slot * _GlxProbeRaysPerProbe;
        [loop] for (uint i = 32u; i < _GlxProbeRaysPerProbe; ++i)
        {
            GlxProbePayload p = _GlxProbeResults[base + i];
            if ((p.flags & (GLX_HIT | GLX_SKY)) == 0) continue; // unresolved carries no sample
            if (!all(isfinite(p.radiance)) || any(p.radiance < 0)) continue;
            float w = saturate(dot(normal, _GlxProbeRays[base + i].directionTMax.xyz));
            if (w <= 0) continue;
            sum += w * p.radiance;
            denominator += w;
        }
        if (denominator > 0)
        {
            uint2 texel = tileBase + id.xy;
            float3 current = PI * sum / denominator;
            float3 value = current;
            if (_GlxProbePublished[probe] != 0)
            {
                // Blend in the gamma-5 storage domain like RTXGI, so its absolute thresholds
                // apply to a perceptual range: linear E exceeds 1 routinely and would keep
                // tripping the change detector.
                float3 previous = _GlxProbeIrrPrev[texel].rgb;
                float3 currentEnc = pow(max(current, 0.0), 0.2);
                float3 previousEnc = pow(max(previous, 0.0), 0.2);
                float hysteresis = _GlxProbePreviousWeight;
                float3 delta = currentEnc - previousEnc;
                if (GlxMax3(previousEnc - currentEnc) > 0.2) // probeIrradianceThreshold
                    hysteresis = max(0.0, hysteresis - 0.75);
                if (GlxLuminance(delta) > 1.0) // probeBrightnessThreshold
                    delta *= 0.25;
                float3 lerpDelta = (1.0 - hysteresis) * delta;
                const float minDelta = 1.0 / 1024.0;
                if (GlxMax3(currentEnc) < GlxMax3(previousEnc))
                    lerpDelta = min(max(minDelta, abs(lerpDelta)), abs(delta)) * sign(lerpDelta);
                value = pow(max(previousEnc + lerpDelta, 0.0), 5.0);
            }
            if (!all(isfinite(value))) value = 0;
            _GlxProbeIrrWrite[texel] = float4(value, 1);
            InterlockedOr(_GlxProbeUpdated[probe], 1u);
        }
    }
    AllMemoryBarrierWithGroupSync();
    if (active)
    {
        for (uint index = id.y * IRR_TILE + id.x; index < IRR_BORDER_TEXELS; index += IRR_TILE * IRR_TILE)
        {
            uint4 o = IRR_BORDER_OFFSETS[index];
            _GlxProbeIrrWrite[tileBase + o.zw] = _GlxProbeIrrWrite[tileBase + o.xy];
        }
    }
}

// Sky samples enter the moments at the moment cap: the miss shader writes the sky range as
// hitT, so an open direction stops occluding its neighbours instead of storing a zero mean.
[numthreads(DIST_TILE, DIST_TILE, 1)]
void ProbeDistance(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.z;
    uint probe = _GlxProbeBatch[slot];
    bool active = _GlxProbeData[probe].w > 0.5;
    bool interior = id.x >= 1u && id.x <= DIST_INTERIOR && id.y >= 1u && id.y <= DIST_INTERIOR;
    uint2 tileBase = uint2((probe % PROBES_PER_ROW) * DIST_TILE, (probe / PROBES_PER_ROW) * DIST_TILE);

    if (active && interior)
    {
        float3 normal = GlxOctNormal(DIST_INTERIOR, (int)id.x - 1, (int)id.y - 1);
        float sum = 0, sumSq = 0, denominator = 0;
        uint base = slot * _GlxProbeRaysPerProbe;
        [loop] for (uint i = 32u; i < _GlxProbeRaysPerProbe; ++i)
        {
            GlxProbePayload p = _GlxProbeResults[base + i];
            if ((p.flags & (GLX_HIT | GLX_SKY)) == 0) continue;
            // Narrow lobe: a cosine-weighted moment map is too blurred to separate near and
            // far hits per octahedral texel, which weakens the query-time Chebyshev test.
            float w = pow(saturate(dot(normal, _GlxProbeRays[base + i].directionTMax.xyz)), 64.0);
            if (w <= 0) continue;
            float d = min(max(p.hitT, 0.0), _GlxProbeMomentCap);
            sum += w * d;
            sumSq += w * d * d;
            denominator += w;
        }
        if (denominator > 0)
        {
            uint2 texel = tileBase + id.xy;
            float2 current = float2(sum, sumSq) / denominator;
            bool published = _GlxProbePublished[probe] != 0;
            float2 value = published ? lerp(current, _GlxProbeDistPrev[texel], _GlxProbePreviousWeight) : current;
            if (!all(isfinite(value))) value = 0;
            _GlxProbeDistWrite[texel] = value;
        }
    }
    AllMemoryBarrierWithGroupSync();
    if (active)
    {
        for (uint index = id.y * DIST_TILE + id.x; index < DIST_BORDER_TEXELS; index += DIST_TILE * DIST_TILE)
        {
            uint4 o = DIST_BORDER_OFFSETS[index];
            _GlxProbeDistWrite[tileBase + o.zw] = _GlxProbeDistWrite[tileBase + o.xy];
        }
    }
}

// Reads only the fixed 32 maintenance rays, which return the shading normal in radiance.
// This batch traced from the published offset/state; the result is consumed by the next batch.
[numthreads(64, 1, 1)]
void ProbeMaintain(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _GlxProbeBudget) return;
    uint probe = _GlxProbeBatch[slot];
    float4 data = _GlxProbeData[probe];
    float3 gridPosition = GlxGridPosition(probe);
    float3 origin = gridPosition + data.xyz;

    uint traced = 0, back = 0, front = 0;
    bool frontWithinCell = false;
    float minFront = 1e30;
    float3 normalSum = 0, hitSum = 0, backNormalSum = 0;
    uint base = slot * _GlxProbeRaysPerProbe;
    [loop] for (uint i = 0u; i < 32u; ++i)
    {
        GlxProbePayload p = _GlxProbeResults[base + i];
        if ((p.flags & GLX_HIT) == 0) continue;
        float3 direction = _GlxProbeRays[base + i].directionTMax.xyz;
        float3 normal = p.radiance;
        if (dot(normal, normal) < 0.25) continue; // geometry shader misses a degenerate normal
        normal = normalize(normal);
        ++traced;
        if (dot(normal, direction) > 0)
        {
            ++back; // ray leaves the surface: the probe is inside closed geometry
            backNormalSum += normal;
            continue;
        }
        ++front;
        minFront = min(minFront, p.hitT);
        if (p.hitT <= _GlxProbeSpacing) frontWithinCell = true;
        normalSum += normal;
        hitSum += origin + direction * p.hitT;
    }

    bool inside = _GlxProbeRelocate != 0 && traced > 0 && (float)back / (float)traced > _GlxProbeInsideBackface;
    bool near = _GlxProbeRelocate != 0 && front > 0 && minFront < _GlxProbeMinFront;
    float3 offset = data.xyz;
    if (inside || near)
    {
        // Fully enclosed probes have no front hits; the average back-face normal points
        // towards the nearest exit side and is the only usable push direction.
        float3 normal = dot(normalSum, normalSum) > 0 ? normalize(normalSum)
            : dot(backNormalSum, backNormalSum) > 0 ? normalize(backNormalSum) : float3(0, 1, 0);
        float3 target = front > 0
            ? (inside ? hitSum / (float)front + normal * 0.05
                      : origin + normal * (_GlxProbeMinFront - minFront + 0.01))
            : origin + normal * min(_GlxProbeSpacing * 0.25, _GlxProbeRelocationLimit);
        offset = target - gridPosition;
        float lengthOffset = length(offset);
        if (lengthOffset > _GlxProbeRelocationLimit)
            offset *= _GlxProbeRelocationLimit / lengthOffset;
    }
    else
    {
        offset = 0;
    }

    float state = data.w;
    if (_GlxProbeClassify != 0) state = (!inside && frontWithinCell) ? 1.0 : 0.0;
    _GlxProbeDataNext[probe] = float4(offset, state);
}

[numthreads(64, 1, 1)]
void ProbePublishMask(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _GlxProbeBudget) return;
    uint probe = _GlxProbeBatch[slot];
    _GlxProbePublishedNext[probe] = _GlxProbePublished[probe] | _GlxProbeUpdated[probe];
}

[numthreads(IRR_TILE, IRR_TILE, 1)]
void ProbeReadbackIrr(uint3 id : SV_DispatchThreadID)
{
    uint2 texel = uint2((_GlxProbeReadbackProbe % PROBES_PER_ROW) * IRR_TILE + id.x,
                        (_GlxProbeReadbackProbe / PROBES_PER_ROW) * IRR_TILE + id.y);
    _GlxProbeReadbackIrr[id.y * IRR_TILE + id.x] = float4(_GlxProbeIrrPrev[texel].rgb, 1);
}

[numthreads(DIST_TILE, DIST_TILE, 1)]
void ProbeReadbackDist(uint3 id : SV_DispatchThreadID)
{
    uint2 texel = uint2((_GlxProbeReadbackProbe % PROBES_PER_ROW) * DIST_TILE + id.x,
                        (_GlxProbeReadbackProbe / PROBES_PER_ROW) * DIST_TILE + id.y);
    float2 value = _GlxProbeDistPrev[texel];
    _GlxProbeReadbackDist[id.y * DIST_TILE + id.x] = float4(value, 0, 0);
}

[numthreads(1, 1, 1)]
void ProbeReadbackMeta(uint3 id : SV_DispatchThreadID)
{
    _GlxProbeReadbackMeta[0] = uint2(_GlxProbePublished[_GlxProbeReadbackProbe], _GlxProbeData[_GlxProbeReadbackProbe].w > 0.5 ? 1u : 0u);
}
