# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Local player builds (rebuilt by ScreenSpaceLightingBaselineSetup / ScreenSpaceLightingT14PlayerSetup)
/PLAN/Done/01-ScreenSpaceLighting/validation/T1/Player/
/PLAN/Done/01-ScreenSpaceLighting/validation/T14/Player/

# 23 P0 baseline: the Player is rebuilt by SsrP3BaselineSetup; frame.raw is deterministic and
# regenerated by compare.py's inputs, so only Player.json / frame.png / hashes are kept.
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P0/Player/
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P0/**/frame.raw
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P1/**/frame.raw
# P3 follows the same evidence policy as P0/P1: hashes, PNGs, Player.json and analysis JSON are
# committed; raw frames, capture binaries and buffer dumps stay local.
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/Player/
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/**/frame.raw
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/RenderDoc/**/*.rdc
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/RenderDoc/renderdoc-mcp-export/
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/RenderDoc/out-*/
# P1 RenderDoc captures stay local (2 x ~110 MB, repo .rdc total is already near the 1 GB
# budget); CaptureAnalysis.json records the filenames, sizes, SHAs and every event ID.
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P1/RenderDoc/**/*.rdc
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P1/RenderDoc/renderdoc-mcp-export/

# 06 validation captures are committed as GPU evidence under the 1 GB budget (HANDOFF §7.5).
# Only player binaries and build outputs stay local.

# B6.1 seam-metric inputs: reproducible from the capture, too large to track.
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/**/_R1Original.bin
/PLAN/Done/23-Ray_Tracing_Inprove_2/validation/P3/**/_R2Hits.bin

# Temporary: left local until the RenderDoc handle on this capture is released.
/PLAN/TODO/23-Ray_Tracing_Inprove_2/
